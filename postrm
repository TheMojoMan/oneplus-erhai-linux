#!/bin/bash
# oneplus-erhai-linux postrm: remove the UKI this kernel's postinst installed on
# the ESP. Named to match postinst exactly -- <version-without-localversion>-<root
# partlabel>.efi -- so an upgrade of a *different* kernel package never deletes
# the running one's boot entry.
set -e

# 1. Only on real removal, not on the remove step of an upgrade.
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then

    # 2. Kernel version. dpkg passes the version as $2 on remove; fall back to
    #    the running kernel if it did not. Strip the "+b<N>" Debian revision
    #    that build-kernel.sh appends to the .deb Version (not part of the
    #    kernelrelease; same derivation as postinst).
    KVER="${2%%+b*}"
    if [ -z "$KVER" ]; then
        KVER=$(uname -r)
    fi

    # 3. Root partition label, same derivation as postinst.
    ROOT_LABEL=$(lsblk -no PARTLABEL "$(findmnt -no SOURCE /)" 2>/dev/null)

    if [ -z "$ROOT_LABEL" ]; then
        ROOT_LABEL="linux"
    fi

    # 4. Rebuild the filename postinst used.
    CLEAN_KVER="${KVER//-sm8750-themojoman/}"
    TARGET_EFI="${CLEAN_KVER}-${ROOT_LABEL}.efi"

    # 5. Mount the ESP.
    ESP_PART="/dev/disk/by-partlabel/esp"
    MNT_TMP=$(mktemp -d)
    DEST_FILE="$MNT_TMP/EFI/ubuntu/$TARGET_EFI"
    MOUNT_SUCCESS=false

    if [ -b "$ESP_PART" ]; then
        for i in 1 2 3; do
            if mount "$ESP_PART" "$MNT_TMP" 2>/dev/null; then
                MOUNT_SUCCESS=true
                break
            fi
            sleep 1
        done
    fi

    # 6. Delete the .efi if it is there.
    if [ "$MOUNT_SUCCESS" = true ]; then
        if [ -f "$DEST_FILE" ]; then
            echo "Post-remove: Deleting $TARGET_EFI from ESP..."
            rm -f "$DEST_FILE"
            sync
        else
            echo "Post-remove: $TARGET_EFI not found on ESP, nothing to do."
        fi
        umount "$MNT_TMP"
    else
        echo "Post-remove: ESP not available. Could not delete EFI file (ignored)."
    fi

    rm -rf "$MNT_TMP"

    # 7. Leftovers from depmod, which postinst ran.
    rm -f "/lib/modules/$KVER/modules.dep" \
        "/lib/modules/$KVER/modules.dep.bin" \
        "/lib/modules/$KVER/modules.alias" \
        "/lib/modules/$KVER/modules.alias.bin" \
        "/lib/modules/$KVER/modules.symbols" \
        "/lib/modules/$KVER/modules.symbols.bin" \
        "/lib/modules/$KVER/modules.devname" \
        "/lib/modules/$KVER/modules.softdep" \
        "/lib/modules/$KVER/modules.builtin.alias.bin" \
        "/lib/modules/$KVER/modules.builtin.bin"
    rmdir "/lib/modules/$KVER" 2>/dev/null || true
fi

exit 0
