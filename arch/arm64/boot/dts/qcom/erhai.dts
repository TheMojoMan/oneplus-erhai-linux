/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/clock/qcom,sm8750-gcc.h>
#include <dt-bindings/clock/qcom,sm8750-dispcc.h>
#include <dt-bindings/interconnect/qcom,sm8750-rpmh.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/qcom,rpmh.h>
#include <dt-bindings/sound/qcom,q6dsp-lpass-ports.h>
#include "sm8750.dtsi"
#include "pm8010.dtsi"
#include "pm8550.dtsi"
#define PMK8550VE_SID 8
#include "pm8550ve.dtsi"
#include "pmih0108.dtsi"
#include "pmk8550.dtsi"
#include "pmr735d_a.dtsi"
#include "sm8750-pmics.dtsi"

/ {
	model = "OnePlus Pad 3";
	compatible = "oneplus,erhai", "qcom,sm8750";
	chassis-type = "tablet";

	aliases {
		serial0 = &uart7;
	};

	/*
	 * Memory layout from erhai Android DTS.
	 * The erhai ships with 12 GB LPDDR5X.
	 */
	memory {
		ddr_device_type = <0x08>;
		device_type = "memory";
		reg = <0x00 0x81960000 0x00 0xa0000
		       0x00 0x81a40000 0x00 0x1c0000
		       0x00 0x81cf4000 0x00 0xc000
		       0x00 0x82460000 0x00 0x40000
		       0x00 0xd8600000 0x00 0x00
		       0x00 0xe3720000 0x00 0x1c0e0000
		       0x08 0x80000000 0x00 0x2f700000
		       0x08 0xb0000000 0x00 0x52c0000
		       0x0a 0x00       0x02 0x00
		       0x08 0xc0000000 0x01 0x40000000
		       0x00 0x82800000 0x00 0x2200000
		       0x00 0x89d80000 0x00 0x1c80000
		       0x00 0xa4880000 0x00 0x13780000
		       0x00 0xb81c0000 0x00 0x1cc63000
		       0x00 0xd5100000 0x00 0x2f00000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* No simple-framebuffer DTS node — let EFI GOP handle it via nomodeset */
	};

	/*
	 * Audio — Phase 1 (v273): q6apm/AudioReach sound card cloned from
	 * sm8750-mtp, adapted to erhai rails. Brings up the WCD9395 headset
	 * (USB-C analog DAC/ADC over SoundWire) + LPASS VA-macro DMIC capture.
	 * Ground truth (live OxygenOS /proc/device-tree): WCD9395 is on SoundWire
	 * (wcd939x-rx-slave dev4 on rx-macro swr, wcd939x-tx-slave dev3), reset on
	 * tlmm gpio101 (== mtp). SPEAKERS are 6x Awinic aw882xx on I2C (i2c_hub_4/9)
	 * with NO mainline driver — deliberately NOT wired here (Phase 2).
	 */
	wcd939x: audio-codec {
		compatible = "qcom,wcd9395-codec", "qcom,wcd9390-codec";

		pinctrl-0 = <&wcd_default>;
		pinctrl-names = "default";

		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;
		qcom,micbias4-microvolt = <1800000>;
		qcom,mbhc-buttons-vthreshold-microvolt = <75000 150000 237000 500000 500000 500000 500000 500000>;
		qcom,mbhc-headset-vthreshold-microvolt = <1700000>;
		qcom,mbhc-headphone-vthreshold-microvolt = <50000>;
		qcom,rx-device = <&wcd_rx>;
		qcom,tx-device = <&wcd_tx>;

		reset-gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l15b_1p8>;
		vdd-rxtx-supply = <&vreg_l15b_1p8>;
		vdd-io-supply = <&vreg_l15b_1p8>;
		vdd-mic-bias-supply = <&vreg_bob1>;
		vdd-px-supply = <&vreg_l3g_1p2>;

		#sound-dai-cells = <1>;
	};

	sound {
		compatible = "qcom,sm8750-sndcard", "qcom,sm8450-sndcard";
		model = "OnePlus-Pad-3";
		/* v408 (audio branch): the sound card carries DisplayPort + WCD/VA
		 * audio AND the internal speakers (6x AW88261 on SECONDARY_MI2S_RX).
		 * The card was disabled in v281 because the aw88261 path spammed
		 * "check pll lock fail" — that turned out to be a DTS PINMUX BUG, not
		 * an ADSP/clock wall (SOLVED 2026-06-21): the SECONDARY-TDM pins were
		 * muxed on the LPI &lpass_tlmm gpio6-9 (physically the DMIC pins!)
		 * instead of the MAIN-SoC &tlmm i2s1 gpio121-124. With the corrected
		 * &sec_tdm_active pinmux below, all 6 amps PLL-lock (SYSST 0x0311) on
		 * the native mainline AudioReach SECONDARY_MI2S_RX TDM clock — no
		 * force_i2s, no extra clock param needed. The amps only poll PLL on
		 * stream-start (DAPM PRE_PMU), so they no longer disturb touch. */
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&sec_tdm_active>;
		audio-routing = "IN1_HPHL", "HPHL_OUT",
				"IN2_HPHR", "HPHR_OUT",
				"AMIC2", "MIC BIAS2",
				/* Internal mics: per OxygenOS DT they are WCD9395
				 * digital mics with MIC BIAS; on mainline that
				 * capture runs through wcd939x + tx-macro
				 * (MultiMedia3 / TX_CODEC_DMA_TX_3). */
				"AMIC1", "MIC BIAS1",
				"AMIC2", "MIC BIAS2",
				"AMIC3", "MIC BIAS3",
				"AMIC4", "MIC BIAS4",
				/* mainline DMICn is downstream Digital Mic(n-1) */
				"DMIC1", "MIC BIAS3",
				"DMIC2", "MIC BIAS3",
				"DMIC3", "MIC BIAS1",
				"DMIC4", "MIC BIAS1",
				/* Slot numbers must match the TX SMIC MUX selection
				 * in the UCM (SWR_MIC9 <- ADC1, SWR_MIC4 <- ADC4),
				 * otherwise DAPM never bridges wcd939x -> tx-macro
				 * and the ADCs stay unpowered during capture. */
				"TX SWR_INPUT9", "ADC1_OUTPUT",
				"TX SWR_INPUT4", "ADC4_OUTPUT";

		wcd-playback-dai-link {
			link-name = "WCD Playback";

			codec {
				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		wcd-capture-dai-link {
			link-name = "WCD Capture";

			codec {
				sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		va-dai-link {
			link-name = "VA Capture";

			codec {
				sound-dai = <&lpass_vamacro 0>;
			};

			cpu {
				sound-dai = <&q6apmbedai VA_CODEC_DMA_TX_0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * Speakers — 6x Awinic AW88261 smart amps on SECONDARY_MI2S_RX.
		 * SOLVED 2026-06-21: works on native mainline AudioReach TDM once the
		 * SECONDARY-TDM pinmux is on the correct controller (see &sec_tdm_active
		 * on &tlmm below). All 6 amps PLL-lock and produce audible output.
		 * Audible output also needs the AudioReach tplg to define a
		 * SECONDARY_MI2S_RX backend graph (OnePlus-Pad-3 tplg on sda17 provides
		 * MODULE_ID_TDM_SINK on this BE).
		 */
		speaker-dai-link {
			link-name = "Speaker Playback";

			cpu {
				sound-dai = <&q6apmbedai SECONDARY_MI2S_RX>;
			};

			codec {
				sound-dai = <&speaker_amp_ch0>,
					    <&speaker_amp_ch1>,
					    <&speaker_amp_ch2>,
					    <&speaker_amp_ch3>,
					    <&speaker_amp_ch5>,
					    <&speaker_amp_ch6>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};

		/*
		 * v278: DisplayPort audio out (DP-alt-mode over USB-C to an
		 * external monitor). codec = &mdss_dp0 — the msm DP controller
		 * registers a drm_hdmi_audio codec (#sound-dai-cells=0 in
		 * sm8750.dtsi); cpu = q6apmbedai DISPLAY_PORT_RX_0 backend, whose
		 * MODULE_ID_DISPLAY_PORT_SINK HW-EP lives in the AudioReach
		 * topology (OnePlus-Pad-3.m4, IID 0x400a). Ref: sm8650-ayaneo /
		 * X1E80100-CRD. sc8280xp.c machine driver already does DP jack
		 * setup for DISPLAY_PORT_RX_0..7.
		 */
		dp-dai-link {
			link-name = "DisplayPort Playback";

			cpu {
				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
			};

			codec {
				sound-dai = <&mdss_dp0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};

	pmic-glink {
		compatible = "qcom,sm8750-pmic-glink",
			     "qcom,sm8550-pmic-glink",
			     "qcom,pmic-glink";
		#address-cells = <1>;
		#size-cells = <0>;
		orientation-gpios = <&tlmm 61 GPIO_ACTIVE_HIGH>;

		connector@0 {
			compatible = "usb-c-connector";
			reg = <0>;

			power-role = "dual";
			data-role = "dual";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					pmic_glink_hs_in: endpoint {
						remote-endpoint = <&usb_dwc3_hs>;
					};
				};

				port@1 {
					reg = <1>;
					pmic_glink_ss_in: endpoint {
						remote-endpoint = <&usb_dp_qmpphy_out>;
					};
				};

				/* v208: SBU side-channel → WCD939x USBSS mux
				 * (orientation + DP-altmode AUX + USB-C analog audio). */
				port@2 {
					reg = <2>;
					pmic_glink_sbu: endpoint {
						remote-endpoint = <&wcd_usbss_sbu_mux>;
					};
				};

				/* v226: DP-altmode HPD link. pmic_glink_altmode
				 * registers a drm_aux_hpd_bridge whose of_node is THIS
				 * connector node; the DP controller finds it as its
				 * next_bridge via mdss_dp0 port@1 (dp-controller binding:
				 * port@1 -> &typec connector). The actual DP lanes reach
				 * the combo PHY via the phys phandle on &mdss_dp0, not
				 * this graph edge — this edge only carries HPD. */
				port@3 {
					reg = <3>;
					pmic_glink_dp_in: endpoint {
						remote-endpoint = <&mdss_dp0_out>;
					};
				};
			};
		};
	};

	bat: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <6300000>;
	};

	clocks {
		xo_board: xo-board {
			compatible = "fixed-clock";
			clock-frequency = <76800000>;
			#clock-cells = <0>;
		};

		sleep_clk: sleep-clk {
			compatible = "fixed-clock";
			clock-frequency = <32000>;
			#clock-cells = <0>;
		};

		bi_tcxo_div2: bi-tcxo-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK>;
			clock-mult = <1>;
			clock-div = <2>;
		};

		bi_tcxo_ao_div2: bi-tcxo-ao-div2-clk {
			compatible = "fixed-factor-clock";
			#clock-cells = <0>;

			clocks = <&rpmhcc RPMH_CXO_CLK_A>;
			clock-mult = <1>;
			clock-div = <2>;
		};
	};

	/*
	 * PSCI / CPU power domains are fully defined in sm8750.dtsi:
	 * cpu_pd0–cpu_pd7, cluster0_pd, cluster1_pd, system_pd.
	 * No board-level overrides needed here.
	 */

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		gunyah_hyp_mem: gunyah-hyp@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0xe00000>;
		};

		cpusys_vm_mem: cpusys-vm-mem@80e00000 {
			no-map;
			reg = <0x00 0x80e00000 0x00 0x400000>;
		};

		cpucp_mem: cpucp@81200000 {
			no-map;
			reg = <0x00 0x81200000 0x00 0x200000>;
		};

		bl_dtlog_mem: xbl-dtlog@81a00000 {
			no-map;
			reg = <0x00 0x81a00000 0x00 0x40000>;
		};

		aop_image_mem: aop-image@81c00000 {
			no-map;
			reg = <0x00 0x81c00000 0x00 0x60000>;
		};

		aop_cmd_db_mem: aop-cmd-db@81c60000 {
			compatible = "qcom,cmd-db";
			no-map;
			reg = <0x00 0x81c60000 0x00 0x20000>;
		};

		aop_tme_uefi_merged_mem: aop-tme-uefi-merged@81c80000 {
			no-map;
			reg = <0x00 0x81c80000 0x00 0x74000>;
		};

		smem_mem: smem@81d00000 {
			compatible = "qcom,smem";
			reg = <0x00 0x81d00000 0x00 0x200000>;
			hwlocks = <&tcsr_mutex 3>;
			no-map;
		};

		pdp_ns_shared_mem: pdp-ns-shared@81f00000 {
			no-map;
			reg = <0x00 0x81f00000 0x00 0x100000>;
		};

		cpucp_scandump_mem: cpucp-scandump@82000000 {
			no-map;
			reg = <0x00 0x82000000 0x00 0x380000>;
		};

		adsp_mhi_mem: adsp-mhi@82380000 {
			no-map;
			reg = <0x00 0x82380000 0x00 0x20000>;
		};

		soccp_sdi_mem: soccp-sdi@823a0000 {
			no-map;
			reg = <0x00 0x823a0000 0x00 0x40000>;
		};

		pmic_minii_dump_mem: pmic-minii-dump@823e0000 {
			no-map;
			reg = <0x00 0x823e0000 0x00 0x80000>;
		};

		pvmfw_mem: pvmfw@824a0000 {
			no-map;
			reg = <0x00 0x824a0000 0x00 0x100000>;
		};

		global_sync_mem: global-sync@82600000 {
			no-map;
			reg = <0x00 0x82600000 0x00 0x100000>;
		};

		tz_stat_mem: tz-stat@82700000 {
			no-map;
			reg = <0x00 0x82700000 0x00 0x100000>;
		};

		qdss_mem: qdss@82800000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x82800000 0x00 0x2000000>;
			no-map;
		};

		dsm_partition_1_mem: dsm-partition-1@84a00000 {
			no-map;
			reg = <0x00 0x84a00000 0x00 0x4900000>;
		};

		dsm_partition_2_mem: dsm-partition-2@89300000 {
			no-map;
			reg = <0x00 0x89300000 0x00 0xa80000>;
		};

		mpss_mem: mpss@8ba00000 {
			no-map;
			reg = <0x00 0x8ba00000 0x00 0xf600000>;
		};

		q6_mpss_dtb_mem: q6-mpss-dtb@9b000000 {
			no-map;
			reg = <0x00 0x9b000000 0x00 0x80000>;
		};

		ipa_fw_mem: ipa-fw@9b080000 {
			no-map;
			reg = <0x00 0x9b080000 0x00 0x10000>;
		};

		ipa_gsi_mem: ipa-gsi@9b090000 {
			no-map;
			reg = <0x00 0x9b090000 0x00 0xa000>;
		};

		gpu_micro_code_mem: gpu-micro-code@9b09a000 {
			no-map;
			reg = <0x00 0x9b09a000 0x00 0x2000>;
		};

		spss_region_mem: spss@9b0a0000 {
			no-map;
			reg = <0x00 0x9b0a0000 0x00 0x1e0000>;
		};

		/* First part of the "SPU secure shared memory" region */
		spu_tz_shared_mem: spu-tz-shared@9b280000 {
			no-map;
			reg = <0x00 0x9b280000 0x00 0x40000>;
		};

		/* Second part of the "SPU secure shared memory" region */
		spu_modem_shared_mem: spu-modem-shared@9b2c0000 {
			no-map;
			reg = <0x00 0x9b2c0000 0x00 0x40000>;
		};

		camera_mem: camera@9b300000 {
			no-map;
			reg = <0x00 0x9b300000 0x00 0x800000>;
		};

		camera_2_mem: camera-2@9bb00000 {
			no-map;
			reg = <0x00 0x9bb00000 0x00 0x800000>;
		};

		video_mem: video@9c300000 {
			no-map;
			reg = <0x00 0x9c300000 0x00 0x800000>;
		};

		cvp_mem: cvp@9cb00000 {
			no-map;
			reg = <0x00 0x9cb00000 0x00 0x700000>;
		};

		cdsp_mem: cdsp@9d200000 {
			no-map;
			reg = <0x00 0x9d200000 0x00 0x1900000>;
		};

		q6_cdsp_dtb_mem: q6-cdsp-dtb@9eb00000 {
			no-map;
			reg = <0x00 0x9eb00000 0x00 0x80000>;
		};

		soccp_mem: soccp@9ec00000 {
			no-map;
			reg = <0x00 0x9ec00000 0x00 0x180000>;
		};

		q6_adsp_dtb_mem: q6-adsp-dtb@9ed80000 {
			no-map;
			reg = <0x00 0x9ed80000 0x00 0x80000>;
		};

		/* v210: size set to the EXACT erhai OEM carveout 0x5080000, read from
		 * the live OxygenOS device tree (/proc/device-tree/reserved-memory/
		 * adspslpi_region@9ee00000/reg). This is exactly our adsp.mdt's load
		 * span (relocatable: min 0x9f300000..max-end 0xa4380000 = 0x5080000 →
		 * relocated to [0x9ee00000, 0xa3e80000]). Earlier values were both
		 * wrong: 0x3a80000 (generic sm8750.dtsi) too small → PAS bails
		 * "segment outside memory range" -22; 0x5a80000 (our 7.1-rc2 base)
		 * over-reserved 10MB beyond the real carveout → PAS hands in-use RAM
		 * to the ADSP VM in TZ → XPU fault → HARD SoC HANG (v209). The exact
		 * OEM size should both fit the fw and avoid claiming live RAM. */
		adspslpi_mem: adspslpi@9ee00000 {
			no-map;
			reg = <0x00 0x9ee00000 0x00 0x5080000>;
		};

		xbl_ramdump_mem: xbl-ramdump@b8000000 {
			no-map;
			reg = <0x00 0xb8000000 0x00 0x1c0000>;
		};

		hwfence_shbuf: hwfence-shbuf@d4e23000 {
			no-map;
			reg = <0x00 0xd4e23000 0x00 0x2dd000>;
		};

		/* Merged tz_reserved, xbl_sc, and qtee regions */
		tz_merged_mem: tz-merged@d8000000 {
			no-map;
			reg = <0x00 0xd8000000 0x00 0x600000>;
		};

		trust_ui_vm_mem: trust-ui-vm@f3800000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf3800000 0x00 0x4400000>;
			no-map;
		};

		oem_vm_mem: oem-vm@f7c00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf7c00000 0x00 0x4c00000>;
			no-map;
		};

		llcc_lpi_mem: llcc-lpi@ff800000 {
			no-map;
			reg = <0x00 0xff800000 0x00 0x800000>;
		};

		device_info_mem: memory@a4f00000 {
			no-map;
			reg = <0x00 0xa4f00000 0x00 0x8000>;
			label = "dump_device_info_mem";
		};

		/*
		 * Splash / Framebuffer region — ABL parks display here.
		 * 3392 × 2400 × 4 bpp = ~30.9 MB; reserve 43 MB (0x2b00000)
		 * as the erhai ABL does.
		 */
		splash_region: splash-region@fc800000 {
			no-map;
			reg = <0x00 0xfc800000 0x00 0x2b00000>;
		};
	};

	/* v16: KTZ8868 ENP/ENN boost enable via TLMM GPIO */
	vreg_ktz_enp: regulator-ktz-enp {
		compatible = "regulator-fixed";
		regulator-name = "ktz8868-enp";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;
		gpio = <&tlmm 111 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vreg_ktz_enn: regulator-ktz-enn {
		compatible = "regulator-fixed";
		regulator-name = "ktz8868-enn";
		regulator-min-microvolt = <5800000>;
		regulator-max-microvolt = <5800000>;
		gpio = <&tlmm 14 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	gpio-keys {
		compatible = "gpio-keys";

		/*
		 * The erhai has a tablet form factor; volume buttons are
		 * on the top edge.  GPIO mapping matches erhai Android DTS.
		 * Volume-down stays on pm8550_gpios 6 (same PMIC as dodge).
		 */
		pinctrl-0 = <&volume_down_n>;
		pinctrl-names = "default";

		key-volume-down {
			label = "Volume Down";
			linux,code = <KEY_VOLUMEDOWN>;
			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
			linux,can-disable;
			wakeup-source;
		};
	};

	vph_pwr: vph-pwr-regulator {
		compatible = "regulator-fixed";

		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;

		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * v238 BT probe: the SM8750 "Peach"/BRAHMA combo has no mainline
	 * compatible yet, but its pwrseq supply/gpio/clock layout matches
	 * wcn7850, so bind the mainline wcn7850 power sequencer to drive
	 * bt-enable (pm8550ve_f gpio3) + RPMH_RF_CLK1. ENABLED for BT (WiFi side
	 * unused). bt-enable-gpios + RF clock verified against Android FDT.
	 */
	wcn7880-pmu {
		compatible = "qcom,wcn7850-pmu";

		/*
		 * WCN7880 needs higher RF/AON rail voltages than the WCN7850 it
		 * shares a compatible with (rfa2 1.31-1.34V not 1.2V, aon >=0.876V);
		 * make the pwrseq driver vote the cnss per-rail voltages instead of
		 * leaving the shared rpmh rails at their floor. Without this the RF
		 * PHY fails cold-boot calibration (wal_pm_wmac_assert_phy_off).
		 */
		qcom,wcn7880-rf-voltages;

		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>, <&bt_default>;

		wlan-enable-gpios = <&tlmm 16 GPIO_ACTIVE_HIGH>;
		bt-enable-gpios = <&pm8550ve_f_gpios 3 GPIO_ACTIVE_HIGH>;

		vdd-supply = <&vreg_s5f_0p85>;
		vddio-supply = <&vreg_l3f_1p8>;
		vddio1p2-supply = <&vreg_l2f_1p2>;
		vddaon-supply = <&vreg_s4d_0p85>;
		vdddig-supply = <&vreg_s1d_0p97>;
		vddrfa1p2-supply = <&vreg_s7i_1p2>;
		vddrfa1p8-supply = <&vreg_s3g_1p8>;

		status = "okay";

		clocks = <&rpmhcc RPMH_RF_CLK1>;

		regulators {
			vreg_pmu_rfa_cmn: ldo0 {
				regulator-name = "vreg_pmu_rfa_cmn";
			};

			vreg_pmu_aon_0p59: ldo1 {
				regulator-name = "vreg_pmu_aon_0p59";
			};

			vreg_pmu_wlcx_0p8: ldo2 {
				regulator-name = "vreg_pmu_wlcx_0p8";
			};

			vreg_pmu_wlmx_0p85: ldo3 {
				regulator-name = "vreg_pmu_wlmx_0p85";
			};

			vreg_pmu_btcmx_0p85: ldo4 {
				regulator-name = "vreg_pmu_btcmx_0p85";
			};

			vreg_pmu_rfa_0p8: ldo5 {
				regulator-name = "vreg_pmu_rfa_0p8";
			};

			vreg_pmu_rfa_1p2: ldo6 {
				regulator-name = "vreg_pmu_rfa_1p2";
			};

			vreg_pmu_rfa_1p8: ldo7 {
				regulator-name = "vreg_pmu_rfa_1p8";
			};

			vreg_pmu_pcie_0p9: ldo8 {
				regulator-name = "vreg_pmu_pcie_0p9";
			};

			vreg_pmu_pcie_1p8: ldo9 {
				regulator-name = "vreg_pmu_pcie_1p8";
			};
		};
	};
	/*
	 * OPLUS sensor subsystem nodes — ground truth: stock Android
	 * devicetree, dtbo_a entry04 ("Qualcomm Technologies, Inc. Sun
	 * MTP,erhai") fragment@83, identical to erhai-sensor-24924.dtsi in
	 * the OnePlus OSS devicetree repo (android_kernel_modules_and_
	 * devicetree_oneplus_sm8750, branch oneplus/sm8750_b_16.0.0_pad_3;
	 * same trio in all 16 erhai dtbo variants).
	 *
	 * Architecture on erhai (verified 2026-09-06): the physical
	 * sensors (accel, gyro, ALS/PS, SAR) have NO AP-side I2C/SPI
	 * nodes — they hang off the SSC, whose user PD runs ON THE ADSP
	 * (SM8750 has no separate SLPI remoteproc; the sun DTB only has
	 * spss/adsp/mss/cdsp/soccp, and sensor_feedback.c maps an
	 * "ADSP_ISLAND" SMEM 613). Android's sensor data path is
	 * USERSPACE: sensors HAL <-> QMI "sensral" over QRTR <-> SSC user
	 * PD, loaded from dsp_a:/adsp (fastrpc_shell_0 + libsns_*_skel.so)
	 * via FastRPC — the libssc/hexagonrpcd model proven on Xiaomi
	 * nabu (github CFM880/nabu-accelerometer) applies. Live probe
	 * (tmp/qrtr-lookup.c): ADSP QRTR node already up with servreg;
	 * sensral appears once a userspace PD loader runs.
	 * The kernel-side oplus drivers (sensor_feedback / ssc_interact /
	 * sensor devinfo) are TELEMETRY/interactive plumbing only
	 * (SMEM 608 stats, panel->SSC brightness hints) — not the data
	 * path. These nodes are therefore inert until that plumbing is
	 * ported; they carry the ground truth for it.
	 * Rails: erhai-sensor-24924.dtsi additionally votes the ldob9
	 * sensor rail (Android name pm_humu_l9) to fixed 2.8 V HPM via a
	 * second rpmh regulator node. ldob9 is the SAME rpmh resource
	 * already in-tree as vreg_l9b_2p9 (camera vaf consumer, 2.96-3.0 V
	 * range): rpmh consumers vote their own voltage on enable, so
	 * adding a duplicate node for the same resource is wrong here —
	 * a future sensor driver simply supplies <&vreg_l9b_2p9>.
	 */
	sensor_fb: sensor_fb {
		compatible = "oplus,sensor-feedback";
		master-id = <3>;
		smem-id = <608>;
	};

	ssc_interactive {
		sup-power-fb;
		sup-hbm-mode = <1>;
		need_lb_algo = <1>;
		receive_screenshot_info = <1>;
		report_blank_mode = <1>;

		primary_lb_brl_info {
			brl_thrd_num = <1>;
			brl_thrd = <1>;
			brl_l2h_thrd = <1>;
		};
	};

	oplus_sensor {
		compatible = "oplus,sensor-devinfo";

		/* virtual magnetometer-fusion sensor */
		mag_fusion {
			sensor-type = <6>; /* OPLUS_MAG_FUSION */
			is-virtual-sensor;
			fusion-type = <0>; /* OPLUS_FUSION */
			fold-feature = <0>;
			drop_zero = <1>;
		};
	};
};

