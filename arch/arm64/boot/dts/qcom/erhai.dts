			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1i_1p2: ldo1 {
			regulator-name = "vreg_l1i_1p2";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2i_1p2: ldo2 {
			regulator-name = "vreg_l2i_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l3i_0p88: ldo3 {
			regulator-name = "vreg_l3i_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <912000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};

	regulators-5 {
		compatible = "qcom,pm8550vs-rpmh-regulators";

		vdd-l1-supply = <&vreg_s1d_0p97>;
		vdd-l2-supply = <&vreg_s7i_1p2>;
		vdd-s2-supply = <&vph_pwr>;
		vdd-s3-supply = <&vph_pwr>;

		qcom,pmic-id = "j";

		vreg_s2j_1p1: smps2 {
			regulator-name = "vreg_s2j_1p1";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_s3j_1p1: smps3 {
			regulator-name = "vreg_s3j_1p1";
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1100000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l1j_0p91: ldo1 {
			regulator-name = "vreg_l1j_0p91";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <920000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};

		vreg_l2j_1p2: ldo2 {
			regulator-name = "vreg_l2j_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
			regulator-allow-set-load;
			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
						   RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

/*
 * rpmhcc override: add sm8650 fallback compatible for kernels that
 * don't yet have the sm8750 entry in clk-rpmh.c.
 * Also add sleep_clk input — the dtsi only lists xo_board.
 */
&rpmhcc {
	compatible = "qcom,sm8750-rpmh-clk",
		     "qcom,sm8650-rpmh-clk";
	clocks = <&xo_board>, <&sleep_clk>;
	clock-names = "xo", "sleep_clk";
};

/*
 * Rear camera flash: pm8550 SPMI flash-LED @0xee00 (4 channels), TWO LEDs.
 *
 * Channel pairing VERIFIED on Android by SPMI write-trace (not inferred):
 * driving led:torch_0 + switch_2 wrote ITARGET 0xee42/0xee45 and CHAN_EN=0x09
 * => LED0 = channels 1+4; led:torch_1 + switch_1 wrote 0xee43/0xee44 and
 * CHAN_EN=0x06 => LED1 = channels 2+3. Downstream's flash_N/torch_N nodes are
 * per-CHANNEL (qcom,id 0..3) and its switches carry qcom,symmetry-en, which is
 * what pulls in each channel's partner: led_switch_0 mask 0x9 = {1,4},
 * led_switch_1 mask 0x6 = {2,3}, led_switch_2 mask 0xf = both LEDs (the one
 * qcom,camera-flash1 uses). Same symmetric pairing as the binding example.
 *
 * Currents: downstream qcom,max-current-ma is PER CHANNEL (flash 0x5dc=1500,
 * torch 0x1f4=500); mainline's flash-max-microamp/led-max-microamp are per-LED
 * TOTALS that leds-qcom-flash.c divides across chan_count
 * (itarg_ua = current_ma * 1000 / chan_count). Values below are deliberately
 * CONSERVATIVE: 1500000/2 = 750mA per channel and 500000/2 = 250mA per channel,
 * both under the per-channel ceiling. Raise only after measuring.
 * flash-max-timeout-us 1280000 = downstream qcom,duration-ms 0x500.
 * hw_type/max_channels are probed from the SUBTYPE register (pm8550 = 4CH),
 * so no DT hint is needed.
 */
&pm8550_flash {
	status = "okay";

	led-0 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <1>, <4>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1500000>;
		flash-max-timeout-us = <1280000>;
		function-enumerator = <0>;
	};

	led-1 {
		function = LED_FUNCTION_FLASH;
		color = <LED_COLOR_ID_WHITE>;
		led-sources = <2>, <3>;
		led-max-microamp = <500000>;
		flash-max-microamp = <1500000>;
		flash-max-timeout-us = <1280000>;
		function-enumerator = <1>;
	};
};


&pm8550_gpios {
	volume_down_n: volume-down-n-state {
		pins = "gpio6";
		function = "normal";
		bias-pull-up;
		input-enable;
		power-source = <1>;
	};
};

&pon_pwrkey {
	status = "okay";
};

&pon_resin {
	linux,code = <KEY_VOLUMEUP>;

	status = "okay";
};

/*
 * PCIe0 / WiFi (WCN "peach", PCI 0x17cb:0x110e) — v248 Step-3a bring-up.
 * Goal: train the PCIe link + enumerate the WCN endpoint so its WLAN firmware
 * download patches the shared TME-L core (which gates Bluetooth). The WCN chip
 * is powered at bus-scan by the PCI pwrctrl-pwrseq driver, which matches the
 * wifi@0 compatible "pci17cb,1107" (WCN7850; 0x110e is not a recognised pwrseq
 * id) and runs the wcn7850-pmu power sequence (regulators + wlan-enable gpio)
 * BEFORE link training — that is what the old "disabled to avoid stall" comment
 * was missing. ath12k will NOT bind yet (real id 0x110e not in its table); that
 * is Step 3b. This step just proves PCIe + power + enumeration.
 */
&pcie0 {
	/*
	 * v472: LTR_L1.2 threshold for the WCN link, verbatim from the Android
	 * pcie0 node (android-dt-2026-06-25). Consumed by pcie-qcom's msm_pcie-
	 * faithful L1SS programmer (qcom_pcie_wcn_program_l1ss) — programs CTL1
	 * LTR_L1.2 + enables L1.1/L1.2 on the RC and the WCN endpoint so the cal
	 * fw's l1ss-sleep init step sees the link reach L1.2.
	 */
	/* Live OxygenOS readback (working path): EP L1SS CTL1=0x40df000f,
	 * RC=0x40df460f -> LTR_L1.2 threshold VALUE=0xDF, SCALE=2. The captured
	 * static Android DT said 0x96, but the running device programs 0xDF; the
	 * live register is ground truth. msm_pcie writes this verbatim (shift 16). */
	qcom,l1-2-th-value = <0xdf>;
	qcom,l1-2-th-scale = <0x02>;

	/*
	 * v437: the WCN PCIe WAKE# (tlmm 104) is moved to the wifi@0 node below as
	 * wlan-wake-gpios -- mainline pcie-qcom does NOT consume the RC wake-gpios
	 * (verified: no gpiod_get("wake") on the RC path), so it was a dead property
	 * and the WAKE# PDC pin was never armed during active operation. cnss arms it
	 * (pdc_enable_intr=0x22) and handles WAKE# across cold-boot-cal; ath12k now
	 * owns + arms it (wcn7880_wake). See wifi@0/wlan-wake-gpios.
	 */
	perst-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	/*
	 * v407: cap the inbound (PCI->CPU) DMA window to [0, 0xb0000000) so the
	 * GIC ITS SW-MSI doorbell (and all 32-bit DMA) is allocated INSIDE the
	 * peach fw's required SMMU window. <pci_addr(3) cpu_addr(2) size(2)>:
	 * 0x02000000 = 32-bit non-prefetchable mem space; base 0 (identity, NO
	 * offset); size 0xb0000000 -> bus_dma_limit 0xafffffff at of_dma_configure.
	 * Mirrors cnss's smmu_iova window end (0xb0000000). See the v407 stage
	 * note above for the full root cause (line-2838/3142 fw asserts).
	 *
	 * v471: REVERTED to the baseline 0xb0000000 cap. The v470 4GB widening (to
	 * let of_translate_dma_region translate the iommu-addresses reservation) is
	 * dropped together with that reservation — cnss now takes the S1 window from
	 * qcom,iommu-dma-addr-pool (no of_translate, no resv regions). This cap is
	 * the ath12k-proven baseline; MHI (bus_dma_limit 0xafffffff) + the fixed-IOVA
	 * fw-mem band (0x198xxxxx) both sit below it.
	 */
	dma-ranges = <0x02000000 0x0 0x00000000  0x0 0x00000000  0x0 0xb0000000>;

	pinctrl-0 = <&pcie0_default_state>;
	pinctrl-names = "default";

	/*
	 * v455/v456 (lever D1): CAP the WCN link to Gen1 x1 for the WHOLE WCN
	 * session. BROAD cold-boot-cal STATE diff (STATE-DIFF-FINDINGS-2026-06-26):
	 * the working OxygenOS link sits at Gen1 x1 (2.5 GT/s) the ENTIRE cal; ours
	 * stayed Gen3 (we honored the bw_scale width 2->1 but NOT the speed). The
	 * dynamic Gen3->Gen1 retrain at BW_REQ (ath12k wcn7880_bw_scale_retrain,
	 * lever M1) FROZE the LTSSM mid-cal; a static cap trains the link directly to
	 * Gen1 x1 with NO mid-cal LTSSM Recovery. v455 CONFIRMED this works (link =
	 * Gen1 x1 cal-start->RDDM, no freeze) but cal still RDDM'd byte-identically.
	 *
	 * v456 pairs D1 with a CORRECTED D2: the avg-bw floor (lever D2) is the
	 * pcie0_opp_table opp-avg-kBps in sm8750.dtsi -- NOT pcie-qcom.c. This
	 * platform votes PCIe->DDR bandwidth via the OPP table (use_pm_opp=true), so
	 * the v455 driver-side icc_mem avg edit was DEAD CODE (icc_mem NULL) and the
	 * avg stayed 0 -- D2 was UNTESTED in v455, not refuted. v456 makes the avg
	 * floor actually land (target: 1c00000.pcie avg=500 in interconnect_summary).
	 *
	 * We question every prior result; treat the old "static Gen1 RDDM-identical"
	 * note as not-trusted. Cost once cal works: WCN stays Gen1 -- moot while cal
	 * still RDDMs.
	 *
	 * v474 (lever #18, 2026-07-08): Gen1 cap LIFTED back to Android's boot value.
	 * Android ground truth: "Default PCI link speed is 0x3, link width is 0x2"
	 * (cnss_pci_get_link_status @2.23) -- the link boots Gen3 x2 and is retrained
	 * to Gen1 by the HOST at the cal BW_REQ (+87ms), via msm_pcie_set_link_bandwidth
	 * (prevent_l1 -> TLS -> RL retrain -> CRM Gen1 re-vote -> allow_l1). Our static
	 * Gen1 pin made the fw down-train x2->x1 UNILATERALLY (host handler no-ops,
	 * "already at target speed") and from that instant L1.2 entries FREEZE for the
	 * rest of cal AND all of mission -- mission fw's l1ss deep sleep needs L1.2 ->
	 * poll fail -> PCSS watchdog -> NOC RDDM at fw_ready+275ms (b14/b15/b16/b17
	 * SFR: NOC_error_patched.c:437:0x8). The old "retrain FROZE LTSSM" (M1) ran
	 * pre-QDSS on a doomed cal AND bracket-less (raw RL on an L1-enabled link);
	 * ath12k's retrain now replicates the msm ASPM-off/L0-settle/RL/restore
	 * bracket. Gen3 boot -> cooperative BW_REQ retrain = full Android replay.
	 */
	max-link-speed = <3>;

	status = "okay";
};

&pcie0_phy {
	vdda-phy-supply = <&vreg_l1f_0p88>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&pcieport0 {
	/*
	 * v250: PERST# for this WCN endpoint. Our pcie-qcom.c takes the
	 * MULTIPORT parse path (pcie@0 has device_type="pci" + phys), which
	 * reads PERST only from a "reset-gpios" property walked depth-first
	 * from THIS port node — NOT the legacy "perst-gpios" on the controller
	 * (&pcie0). Without this the endpoint is held in reset and the link
	 * never trains ("Device not found"), even with the chip powered.
	 * tlmm102 confirmed = Android perst-gpio (0x66). Active-low.
	 */
	reset-gpios = <&tlmm 102 GPIO_ACTIVE_LOW>;

	wcn_ep: wifi@0 {
		compatible = "pci17cb,1107";
		reg = <0x10000 0x0 0x0 0x0 0x0>;

		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;
		vddpcie0p9-supply = <&vreg_pmu_pcie_0p9>;
		vddpcie1p8-supply = <&vreg_pmu_pcie_1p8>;

		/*
		 * v313: AOSS QMP mailbox handle, mirroring the Android
		 * qcom,cnss-peach node. ath12k's WCN7880 path uses this to
		 * program the WLAN PDC (cnss_aop_pdc_reconfig equivalent) at
		 * probe via qmp_get()/qmp_send() before cold-boot calibration.
		 */
		qcom,qmp = <&aoss_qmp>;

		/*
		 * v436: dev/host Signal-of-Life GPIOs (long-shot SOL prototype,
		 * consumed only when ath12k_wifi7_pci.wcn7880_sol=1). cnss wires
		 * these as the out-of-band device<->host wake/RDDM-coordination
		 * lines (OxygenOS cnss boot log, tlmm base 512):
		 *   dev-SOL  = tlmm 203 (global 715): device->host input+IRQ; the
		 *              peach fw asserts it to signal the host.
		 *   host-SOL = tlmm 202 (global 714): host->device output; cnss
		 *              drives it to "retry RDDM, expecting link down".
		 * Used to test whether the fw toggles dev-SOL during cold-boot-cal
		 * (a handshake mainline ath12k would otherwise miss). Free pins on
		 * erhai (unused elsewhere in this DTS).
		 */
		wlan-dev-sol-gpios  = <&tlmm 203 GPIO_ACTIVE_HIGH>;
		wlan-host-sol-gpios = <&tlmm 202 GPIO_ACTIVE_HIGH>;

		/*
		 * v437: PCIe WAKE# (tlmm 104), the second out-of-band device->host
		 * signal in the same plane as SOL. cnss routes it through the PDC and
		 * keeps it enabled during active operation; mainline pcie-qcom left it
		 * unconsumed (never armed). ath12k arms it as a wakeup IRQ
		 * (wcn7880_wake, default on) so a fw WAKE# assertion during cold-boot-
		 * cal is captured and the PDC-arming divergence is closed. Moved here
		 * from &pcie0 (where it was dead).
		 */
		wlan-wake-gpios = <&tlmm 104 GPIO_ACTIVE_HIGH>;

		/*
		 * v470 (LITERAL Android SMMU-S1 window — NOT reverse-engineered):
		 * replicate the OnePlus sun-peach-cnss.dtsi `cnss_pci0` iommu setup
		 * verbatim so cnss's OWN cnss_pci_init_smmu()/cnss_pci_get_iommu_addr()
		 * enable S1 + advertise the host_cap ddr_range. cnss reads the S1
		 * window from qcom,iommu-dma-addr-pool on that group node (the
		 * downstream `#else` cnss_pci_get_iommu_addr path).
		 *
		 * v471: the v470 `memory-region`+`iommu-addresses` partition is REMOVED.
		 * On mainline it made of_iommu_get_resv_regions() reserve holes in the
		 * generic iommu-dma domain, which REGRESSED the WCN fw (both cnss and
		 * ath12k RDDM'd at RESPOND_MEM vs the baseline reaching cal). The window
		 * confinement we actually need is done in cnss C code (bus_dma_limit cap
		 * + explicit fixed-IOVA fw-mem mapping), not by a domain reservation.
		 */
		qcom,iommu-group = <&cnss_audio_iommu_group0>;
	};
};

/*
 * v470: the iommu-group node the WCN endpoint (wifi@0) points at via
 * qcom,iommu-group. cnss's own cnss_pci_init_smmu() reads qcom,iommu-dma="fastmap"
 * here to set smmu_s1_enable (→ host_cap ddr_range gets sent) and reads
 * qcom,iommu-geometry for the S1 window. Verbatim from the OnePlus Android DT
 * (oplus-sm8750 sun.dtsi /soc/cnss_audio_iommu_group0 + the live device DT).
 * This node is consumed ONLY by cnss's C code (of_parse_phandle + read-string);
 * it is not a mainline iommu construct, so it is inert to the iommu core.
 */
&soc {
	cnss_audio_iommu_group0: cnss_audio_iommu_group0 {
		qcom,iommu-msi-size = <0x1000>;
		qcom,iommu-geometry = <0x18000000 0x98010000>;
		/*
		 * v471: cnss reads the S1 window [start, len] straight from here
		 * (cnss_pci_get_iommu_addr `#else` branch). start=0x18000000,
		 * len=0x98000000 → window top 0xb0000000, the peach fw ddr_range.
		 * A plain vendor property mainline never reserves (unlike
		 * memory-region/iommu-addresses) — no domain side-effect on the fw.
		 */
		qcom,iommu-dma-addr-pool = <0x18000000 0x98000000>;
		qcom,iommu-dma = "fastmap";
		qcom,iommu-pagetable = "coherent";
		qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
	};
};

&pmih0108_eusb2_repeater {
	status = "okay";

	vdd18-supply = <&vreg_l15b_1p8>;
	vdd3-supply = <&vreg_l5b_3p1>;
};

/* v208: WCD939x USB-SS mux — the SM8750 SBU/orientation switch (same part as
 * sm8750-mtp; Pad 3 downstream wires wcd939x at i2c addr 0xe on qup se3 = i2c3).
 * Provides the typec mode-switch + orientation-switch consumed by the
 * pmic-glink connector's SBU port (port@2). Without this built-in, the SBU
 * endpoint reference can EPROBE_DEFER pmic_glink_altmode and stall the whole
 * connector — so CONFIG_TYPEC_MUX_WCD939X_USBSS must be =y (see .config bump).
 * NOTE: reset-gpios <&tlmm 152> is the SM8750 reference value — VERIFY against
 * the Pad 3 schematic; the prop is optional and can be dropped if it's wrong. */
&i2c3 {
	status = "okay";

	wcd_usbss: typec-mux@e {
		compatible = "qcom,wcd9395-usbss", "qcom,wcd9390-usbss";
		reg = <0xe>;

		vdd-supply = <&vreg_l15b_1p8>;
		reset-gpios = <&tlmm 152 GPIO_ACTIVE_HIGH>;

		mode-switch;
		orientation-switch;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				wcd_usbss_sbu_mux: endpoint {
					remote-endpoint = <&pmic_glink_sbu>;
				};
			};
		};
	};
};

&qupv3_1 {
	status = "okay";
};

&qupv3_2 {
	status = "okay";
};

&i2c_master_hub_0 {
	status = "okay";
};

/*
 * v16: KTZ8868 backlight master IC on i2c_hub_0.
 * v225: erhai splits the backlight across TWO ktz8868 ICs (master here +
 * slave on i2c11, one per panel half). The master owns the ENP/ENN bias and
 * HW-enable GPIOs that power BOTH ICs; the slave shares them and is driven by
 * the master driver via kinetic,secondary-bus. Without the slave only the
 * master's half of the panel backlight lights (bottom strings dark).
 */
&i2c_hub_0 {
	status = "okay";

	ktz8868_bl: backlight@11 {
		compatible = "kinetic,ktz8868";
		reg = <0x11>;

		/* ENP/ENN boost rails driven by TLMM GPIOs via regulator-fixed */
		vddpos-supply = <&vreg_ktz_enp>;
		vddneg-supply = <&vreg_ktz_enn>;

		/* Hardware enable pin */
		enable-gpios = <&tlmm 15 GPIO_ACTIVE_HIGH>;

		/* Slave ktz8868 lives at the same addr on i2c11 (i2c@88c000) */
		kinetic,secondary-bus = <&i2c11>;
	};
};

/* v225: enable i2c11 so the backlight slave ktz8868 (addr 0x11) is reachable */
&i2c11 {
	status = "okay";
};

/*
 * Hall sensor — erhai is a tablet; the hall sensor detects cover/folio
 * position.  GPIO/I2C address matches the erhai Android DTS.
 * NOTE (2026-09-06 ground truth): NO ak09970/dhall node exists anywhere in
 * the erhai Android devicetree (neither the vendor_boot Sun SoC DTB nor any
 * of the 16 dtbo variants) — this node was carried over from dodge and its
 * compatible has no in-tree driver, so it is inert. Kept as-is pending a
 * verified GPIO/address for the erhai hall IC.
 */
&i2c_hub_9 {
	status = "okay";
	magnachip: magnachip@10 {
		compatible = "oplus,dhall-ak09970";
		reg = <0x10>;
		vcc-supply = <&vreg_l1b_1p8>;
		interrupt-parent = <&tlmm>;
		interrupts = <17 2>;
		threeaxis_hall_support;
		dhall,irq-gpio = <&tlmm 17 0x2008>;
		pinctrl-names = "hall_interrupt_input";
		pinctrl-0 = <&hall_interrupt_input>;
	};

	/*
	 * Awinic AW88261 smart speaker amps (3 of 6) — i2c_hub (Linux bus 3 =
	 * Android bus 9), the LEFT-side trio. Chip PID 0x2113. No reset GPIO
	 * (I2C soft reset). dvdd = 1.8V. `awinic,audio-channel` == vendor
	 * "sound-channel" = ACF device-index; the ACF channel-N profile sets the
	 * amp's TDM RX slot to N (verified live: reg0x07 slot nibble == channel).
	 *
	 * Android GT (the native 8-ch layout): this hub = ch0/ch2/ch6, hub_4 =
	 * ch3/ch1/ch5 — each amp on its OWN slot, fed by an 8-channel speaker
	 * stream the HAL upmixes from stereo.
	 *
	 * v422 (2026-06-21) — 3+3 STEREO REMAP. The Linux desktop stream is
	 * 2-channel, which only fills TDM slots 0 (L) and 1 (R); the other 4 amps
	 * (slots 2,3,5,6) then play SILENCE (verified: only 2 of 6 produced sound).
	 * Quick fix = collapse each physical side onto one populated slot: this
	 * whole hub -> channel 0 (slot 0, LEFT), hub_4 -> channel 1 (slot 1, RIGHT).
	 * Now a 2-ch stream drives all 6 (3 per side). Tradeoff: the 3 amps on a
	 * side share one ACF tuning profile (ch0 / ch1) instead of per-driver
	 * calibration — acceptable for the ~identical drivers; the per-driver 8-ch
	 * layout above is the proper-fix path (topology channel-mixer 2->8).
	 */
	speaker_amp_ch0: speaker@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;
		dvdd-supply = <&vreg_l1b_1p8>;
		awinic,audio-channel = <0>;	/* slot 0 — LEFT */
		sound-name-prefix = "Spk0";
		awinic,sync-flag;
		#sound-dai-cells = <0>;
		status = "okay"; /* v421: speakers SOLVED (pinmux on &tlmm i2s1) */
	};

	speaker_amp_ch2: speaker@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;
		dvdd-supply = <&vreg_l1b_1p8>;
		awinic,audio-channel = <0>;	/* v422: was 2 -> slot 0, LEFT */
		sound-name-prefix = "Spk2";
		awinic,sync-flag;
		#sound-dai-cells = <0>;
		status = "okay"; /* v421: speakers SOLVED (pinmux on &tlmm i2s1) */
	};

	speaker_amp_ch6: speaker@36 {
		compatible = "awinic,aw88261";
		reg = <0x36>;
		dvdd-supply = <&vreg_l1b_1p8>;
		awinic,audio-channel = <0>;	/* v422: was 6 -> slot 0, LEFT */
		sound-name-prefix = "Spk6";
		awinic,sync-flag;
		#sound-dai-cells = <0>;
		status = "okay"; /* v421: speakers SOLVED (pinmux on &tlmm i2s1) */
	};
};

/*
 * i2c_hub_4 (@990000, GENI I2C master hub on QUP_CORE_0) — the other 3
 * AW88261 amps, the RIGHT-side trio (Linux bus 2 = Android bus 4).
 * Android GT per-driver channels: 4-0034 ch=3, 4-0035 ch=1, 4-0036 ch=5.
 * v422: all three remapped to channel 1 (slot 1, RIGHT) for the 3+3 stereo
 * fix — see the LEFT-trio comment on i2c_hub above for the rationale.
 */
&i2c_hub_4 {
	status = "okay";

	speaker_amp_ch3: speaker@34 {
		compatible = "awinic,aw88261";
		reg = <0x34>;
		dvdd-supply = <&vreg_l1b_1p8>;
		awinic,audio-channel = <1>;	/* v422: was 3 -> slot 1, RIGHT */
		sound-name-prefix = "Spk3";
		awinic,sync-flag;
		#sound-dai-cells = <0>;
		status = "okay"; /* v421: speakers SOLVED (pinmux on &tlmm i2s1) */
	};

	speaker_amp_ch1: speaker@35 {
		compatible = "awinic,aw88261";
		reg = <0x35>;
		dvdd-supply = <&vreg_l1b_1p8>;
		awinic,audio-channel = <1>;	/* slot 1 — RIGHT */
		sound-name-prefix = "Spk1";
		awinic,sync-flag;
		#sound-dai-cells = <0>;
		status = "okay"; /* v421: speakers SOLVED (pinmux on &tlmm i2s1) */
	};

	speaker_amp_ch5: speaker@36 {
		compatible = "awinic,aw88261";
		reg = <0x36>;
		dvdd-supply = <&vreg_l1b_1p8>;
		awinic,audio-channel = <1>;	/* v422: was 5 -> slot 1, RIGHT */
		sound-name-prefix = "Spk5";
		awinic,sync-flag;
		#sound-dai-cells = <0>;
		status = "okay"; /* v421: speakers SOLVED (pinmux on &tlmm i2s1) */
	};
};

/*
 * Touchscreen — Novatek NT36536 (in-cell, no-flash) on QUP1 SE4 = spi4
 * (spi@a90000, WRAP1_S4, mainline "qup1_se4": gpio48/49/50 MISO/MOSI/CLK,
 * gpio51 CS). IRQ tlmm162 (level-low). No reset GPIO (in-cell; reset via the
 * XN242 panel). FW host-downloaded every boot from /lib/firmware. Ground truth:
 * OnePlus OSS oplus/tp/erhai-oplus-tp-24924.dtsi (node nt36536@0,
 * compatible novatek,nf_nt36536). Driver = ported nabu NT36xxx SPI base +
 * transplanted NT36536 chip data (drivers/input/touchscreen/nt36523/).
 */
&spi4 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&qup_spi4_data_clk>, <&qup_spi4_cs>;

	touchscreen@0 {
		compatible = "novatek,NVT-ts-spi";
		reg = <0>;
		spi-max-frequency = <12000000>;

		/*
		 * IRQ via the SPI core (client->irq). gpio162, data-ready
		 * FALLING edge (OnePlus DT flag 0x2002). The INT line is set as
		 * input by ts_int_active; the driver does NOT gpio_request it.
		 */
		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&ts_int_active>;

		novatek,swrst-n8-addr = <0x1FB43E>;
		novatek,pen-support;
		novatek,wgp-stylus;

		/*
		 * Raw NT bin (header_end 0x250, cascade=1) stripped from the
		 * OnePlus FW_NT36536_HUAXING.img 80-byte "FwUp" wrapper. Ship to
		 * sda17:/lib/firmware/novatek/FW_NT36536_HUAXING.bin.
		 */
		firmware-name = "novatek/FW_NT36536_HUAXING.bin";
	};
};


&gpi_dma1 {
	status = "okay";
};

&gpi_dma2 {
	status = "okay";
};

/* v8: remoteproc disabled — rule out firmware loading as panic cause.
 * v209: re-enable ADSP. pmic_glink (USB Type-C role detection / PD / VBUS)
 * talks to the PMIC service running on the ADSP over glink; without the ADSP
 * up, pmic_glink fails PDR init ("failed to initialize pdr") and no Type-C
 * port registers, so USB OTG/mode-switching cannot work. Firmware is the
 * device's own signed split image (adsp.mdt + adsp.bNN, adsp_dtb.mdt + .bNN)
 * extracted from OxygenOS — must live at /lib/firmware/qcom/sm8750/OnePlus/
 * on sda17. cdsp/mpss stay disabled (not needed for Type-C). */
&remoteproc_adsp {
	firmware-name = "qcom/sm8750/OnePlus/adsp.mdt",
			"qcom/sm8750/OnePlus/adsp_dtb.mdt";
	status = "okay";
};

/*
 * v271: fix ADSP -EBUSY so charger_pd/battmgr (charging status) can come up.
 * sm8750.dtsi declares adsp_rpc_remote_heap_mem as a DYNAMIC, reusable 12MB
 * shared-dma-pool with alloc-ranges spanning all of 0..0xffffffff. With our
 * erhai-resized adspslpi carveout (0x9ee00000..0xa3e80000), the CMA allocator
 * placed that reusable pool at 0xa3500000 -- INSIDE the no-map adspslpi window
 * -- leaving a busy "reserved" resource there. q6v5_pas then fails to
 * request_mem_region(adspslpi) with -EBUSY at probe, so the ADSP never boots,
 * the charger_pd protection domain never serves, and qcom_battmgr reads -EAGAIN
 * (empty battery/USB props). The heap is consumed ONLY by the ADSP fastrpc
 * compute node, which we don't use; the adsp remoteproc itself needs only
 * adspslpi + q6_adsp_dtb. (The working SM8550 'sheng' tree omits this heap
 * entirely.) Pin its alloc-range to free System RAM clear of every carveout
 * (the 0xa4f08000..0xa7600fff System-RAM block per live /proc/iomem) so the
 * pool can never overlap adspslpi. This does NOT touch adspslpi sizing (the
 * v209 hard-hang hazard) and keeps the fastrpc phandle valid.
 */
&adsp_rpc_remote_heap_mem {
	alloc-ranges = <0x00 0xa5000000 0x00 0x02000000>;
};

&remoteproc_cdsp {
	status = "disabled";
};

&remoteproc_mpss {
	status = "disabled";
};

&tlmm {
	/* reserved for secure world */
	gpio-reserved-ranges = <36 4>, <74 1>;

	/*
	 * Pogo keyboard UART (QUPV3_2 SE0 @0x880000 = Android ttyHS5).
	 * 2-wire half-duplex: gpio2 = TX (qup2_se0 lane2), gpio3 = RX (lane3).
	 * The single pogo data line is bridged to TX/RX through an external
	 * buffer gated by gpio83 (tx-enable); gpio85 powers the keyboard rail,
	 * gpio96 is the plug/wake input — those three are plain gpiods owned by
	 * the pogo-keyboard serdev driver (auto-muxed to gpio func on request).
	 */
	qup_uart8_default: qup-uart8-default-state {
		/* TX, RX */
		pins = "gpio2", "gpio3";
		function = "qup2_se0";
		drive-strength = <8>;
		bias-pull-up;
	};

	ts_reset_active: ts_reset_active-state {
		pins = "gpio161";
		function = "gpio";
		bias-disable;
		output-low;
		drive-strength = <8>;
	};

	ts_int_active: ts_int_active-state {
		pins = "gpio162";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
		input-enable;
	};

	ts_reset_suspend: ts_reset_suspend-state {
		pins = "gpio161";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	ts_int_suspend: ts_int_suspend-state {
		pins = "gpio162";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	hall_interrupt_input: hall-interrupt-input-state {
		pins = "gpio97";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	bt_default: bt-default-state {
		sw-ctrl-pins {
			pins = "gpio18";
			function = "gpio";
			bias-pull-down;
		};
	};

	/*
	 * Display reset / vsync pins — kept in tlmm for reference but the
	 * DSI panel node is disabled.  Remove in v2 if confirmed unused.
	 */
	disp0_reset_n_active: disp0-reset-n-active-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync_active: mdp-vsync-active-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync_suspend: mdp-vsync-suspend-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	wlan_en: wlan-en-state {
		pins = "gpio16";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-down;
	};
};

/*
 * v238 BT probe — HCI-over-UART on uart14 (serial@898000 = Android's BT
 * ttyHS0). 4-wire flow control (default TX/RX + cts_rts CTS/RTS) required at
 * 3.2 Mbaud. No enable-gpios here → hci_qca uses the wcn7850 pwrseq (PMU above
 * owns bt-enable). firmware-name = [NVM, rampatch] forces the BRAHMA blobs
 * staged at /lib/firmware/qca/ (brhbtnv20.bin + brhbtfw20.tlv).
 */
&uart14 {
	pinctrl-names = "default";
	pinctrl-0 = <&qup_uart14_default>, <&qup_uart14_cts_rts>;
	status = "okay";

	bluetooth {
		compatible = "qcom,wcn7880-bt";

		vddrfacmn-supply = <&vreg_pmu_rfa_cmn>;
		vddaon-supply = <&vreg_pmu_aon_0p59>;
		vddwlcx-supply = <&vreg_pmu_wlcx_0p8>;
		vddwlmx-supply = <&vreg_pmu_wlmx_0p85>;
		vddrfa0p8-supply = <&vreg_pmu_rfa_0p8>;
		vddrfa1p2-supply = <&vreg_pmu_rfa_1p2>;
		vddrfa1p8-supply = <&vreg_pmu_rfa_1p8>;

		/* max-speed switches the chip off 115200 (post version-read) to the
		 * EDL fast-download baud. For WCN7850, mainline (hci_qca qca_set_speed)
		 * enables HW flow control ONLY as part of that oper-speed switch — so
		 * without max-speed the TLV download streams flow-control-OFF, the chip
		 * drops the stream, and the last segment times out: "Failed to send TLV
		 * segment (-110)". The cts_rts pinmux above provides the 4-wire lines.
		 *
		 * Rate = 8 Mbaud, the ONLY download baud the OnePlus WCN7880 firmware
		 * actually validates. Android ground truth (bt-coldboot-download-trace):
		 * the HAL sends EDL baud code 0x15 (userial_vendor_set_baud 21) and the
		 * chip reports "Current Baudrate = 8000000 bps", then streams the whole
		 * rampatch at 8M. It never uses any other rate. Earlier 2M (code 0x0d)
		 * and 3.2M (code 0x11) tests garbled/stalled because this firmware's
		 * EDL baud-code table differs from the mainline qca_baudrate enum — only
		 * 0x15 is firmware-proven. hci_qca maps 8000000 -> code 0x15
		 * (QCA_BAUDRATE_8000000); GENI divides cleanly to 8M (route-B proved
		 * the PERI ELF streams flawlessly at 8M). */
		max-speed = <8000000>;

		firmware-name = "brhbtnv20.bin", "brhbtfw20.tlv";

		/*
		 * BD address policy (v239) - firmware/OTP path:
		 *
		 * Stock Android reports the OnePlus factory (OTP) address
		 * 7C:F0:E5:9B:4B:E4 (shared base with the WLAN MLD MAC). Ground
		 * truth: the brhbtnv20*.bin NVM blobs captured from the running
		 * tablet are byte-identical to ours and NONE of them contain the
		 * factory MAC, and stock sun-peach-bt.dtsi has no local-bd-address
		 * property either - so the address lives in the chip's OTP and no
		 * host override exists on Android.
		 *
		 * We therefore mirror that: no local-bd-address property here.
		 * If the controller reports its OTP address it is used as-is.
		 * If it still reports the WCN7850 NVM default 78:55:00:01:5A:AD
		 * (the BD_ADDR tag inside brhbtnv20.bin) or an all-zero address,
		 * qca_check_bdaddr() in btqca.c now programs the fixed fallback
		 * 7C:F0:E5:79:55:54, so hci0 always registers MANAGED (non-RAW)
		 * and bluez/GNOME see it without any btmgmt workaround.
		 *
		 * (Historical v238 workaround: hardcoded C0:FF:EE:13:1E:1A via
		 * local-bd-address - removed because it masked the OTP path.)
		 */

		status = "okay";
	};
};

&uart7 {
	status = "okay";
};

/*
 * v450 — OnePlus Pad 3 magnetic pogo keyboard.
 *
 * QUPV3_2 SE0 @0x880000 (GCC_QUPV3_WRAP2_S0_CLK, GIC_SPI 373) run as a
 * geni-uart — this is Android's "ttyHS5" (880000.qcom,qup_uart). The keyboard
 * is a half-duplex one-wire-bus device at 921600 8N1; once powered it streams
 * HID-boot key reports + a multi-touch touchpad stream autonomously. The
 * pogo-keyboard serdev child decodes that stream (drivers/input/keyboard/
 * oneplus-pogo-kbd.c). Gate-1 ground truth: captures/pogo-kb-android-2026-06-25.
 *
 * gpio2/gpio3 = TX/RX (qup_uart8_default above). The three control lines are
 * gpiods on the child: gpio85 power-enable, gpio83 tx-direction-enable (held
 * low = receive in this RX-only v1), gpio96 plug/wake.
 *
 * NOTE: serial@880000 shares its unit-address with the (disabled) i2c8/spi8
 * nodes of the same SE in sm8750.dtsi — that is the normal muxed-SE pattern.
 */
&qupv3_2 {
	uart8: serial@880000 {
		compatible = "qcom,geni-uart";
		reg = <0x0 0x00880000 0x0 0x4000>;
		interrupts = <GIC_SPI 373 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_QUPV3_WRAP2_S0_CLK>;
		clock-names = "se";
		interconnects = <&clk_virt MASTER_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS
				 &clk_virt SLAVE_QUP_CORE_2 QCOM_ICC_TAG_ALWAYS>,
				<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ALWAYS
				 &config_noc SLAVE_QUP_2 QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "qup-core", "qup-config";
		pinctrl-0 = <&qup_uart8_default>;
		pinctrl-names = "default";
		status = "okay";

		pogo_keyboard: pogo-keyboard {
			compatible = "oneplus,erhai-pogo-keyboard";
			power-gpios = <&tlmm 85 GPIO_ACTIVE_HIGH>;
			tx-enable-gpios = <&tlmm 83 GPIO_ACTIVE_HIGH>;
			wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
			touchpad-xy-max = <0xacc 0x65e>;
			touchpad-xy-resolution = <0x17 0x17>;
		};
	};
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l1j_0p91>;
	vdda-pll-supply = <&vreg_l3g_1p2>;

	status = "okay";
};

&ufs_mem_hc {
	reset-gpios = <&tlmm 215 GPIO_ACTIVE_LOW>;

	/*
	 * vdd-hba is the gcc_ufs_phy_gdsc power domain, not a regulator.
	 * The mainline ufshcd driver consumes it via power-domains.
	 */
	power-domains = <&gcc GCC_UFS_PHY_GDSC>;

	vcc-supply = <&vreg_l17b_2p5>;
	vcc-max-microamp = <1300000>;
	vccq-supply = <&vreg_l1d_1p2>;
	vccq-max-microamp = <1200000>;

	status = "okay";
};

&pm8010_n {
  status = "disabled";
};

&usb {
	status = "okay";
	/* v208: was "peripheral" (device-only) up to v207. Switch to OTG so the
	 * data role is decided at runtime by the Type-C controller via
	 * pmic_glink/UCSI driving usb-role-switch (sheng/mtp model). Plugged into
	 * a host it still enumerates as a gadget (ttyGS0/adb preserved); an OTG
	 * device makes it switch to xhci host. */
	dr_mode = "otg";
};

&usb_dwc3_hs {
	remote-endpoint = <&pmic_glink_hs_in>;
};

&usb_hsphy {
	vdd-supply = <&vreg_l2d_0p88>;
	vdda12-supply = <&vreg_l3g_1p2>;

	phys = <&pmih0108_eusb2_repeater>;

	status = "okay";
};

&usb_dp_qmpphy {
	vdda-phy-supply = <&vreg_l3g_1p2>;
	vdda-pll-supply = <&vreg_l2d_0p88>;

	status = "okay";
};

&usb_dp_qmpphy_out {
	remote-endpoint = <&pmic_glink_ss_in>;
};

&usb_dp_qmpphy_dp_in {
	remote-endpoint = <&mdss_dp0_out>;
};

/* v12: Enable MDSS + dual DSI + XN242 panel (from dodge-kernel v132) */
&mdss {
	status = "okay";

	/* The second MDP datapath sits behind MDSS_INT2_GDSC, and nothing else in
	 * the system votes for it, so it has to be claimed here or it stays
	 * collapsed and enabling MDP1_CLK below hangs. */
	power-domains = <&dispcc MDSS_GDSC>, <&dispcc MDSS_INT2_GDSC>;
};

/* MDP1_CLK clocks the second MDP datapath, which drives the right half of the
 * bonded dual-DSI panel. Without it 144Hz starves (left half washes out, right
 * half breaks into vertical stripes); slower rates still have margin. Its GDSC
 * (MDSS_INT2) is claimed on the parent &mdss node above. */
&mdss_mdp {
	clocks = <&gcc GCC_DISP_HF_AXI_CLK>,
		 <&dispcc DISP_CC_MDSS_AHB_CLK>,
		 <&dispcc DISP_CC_MDSS_MDP_LUT_CLK>,
		 <&dispcc DISP_CC_MDSS_MDP_CLK>,
		 <&dispcc DISP_CC_MDSS_VSYNC_CLK>,
		 <&dispcc DISP_CC_MDSS_MDP1_CLK>;
	clock-names = "nrt_bus",
		      "iface",
		      "lut",
		      "core",
		      "vsync",
		      "core1";
};

/* v226: enable DisplayPort-over-Type-C (altmode) out via INTF0.
 * This is an INDEPENDENT display pipe from the DSI panel (INTF1/INTF2),
 * so it sidesteps the DSI "wall". The DP lanes ride the usb_dp_qmpphy
 * combo PHY (phys phandle, already in sm8750.dtsi); plug detection comes
 * from pmic_glink_altmode's HPD bridge wired below.
 *
 * NOTE: with status=okay, add_mdp_components() makes mdss_dp0 a MANDATORY
 * DRM component (dpu_intf0_out -> mdss_dp0_in). The DP probe defers until
 * its next_bridge (the altmode HPD bridge for connector@0) is registered,
 * which needs pmic_glink + the wcd_usbss typec-mux up. If those never bind,
 * the whole DRM master stays unbound (DSI panel won't light) — but the
 * serial console/adb survive, so this is recoverable by reverting the dtb.
 */
&mdss_dp0 {
	status = "okay";
};

&mdss_dp0_out {
	data-lanes = <0 1>;
	link-frequencies = /bits/ 64 <1620000000 2700000000 5400000000 8100000000>;
	remote-endpoint = <&pmic_glink_dp_in>;
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l3g_1p2>;
	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	qcom,master-dsi;
	status = "okay";

	panel@0 {
		compatible = "oneplus,erhai-xn242";
		reg = <0>;

		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&disp0_reset_n_active>, <&mdp_vsync_active>;
		pinctrl-1 = <&disp0_reset_n_suspend>, <&mdp_vsync_suspend>;

		vddio-supply = <&vreg_l12b_1p8>;
		dvddbuck-supply = <&vreg_l11b_1p0>;
		dvddldo-supply = <&vreg_l13b_3p0>;

		reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;

		qcom,mdss-disable-cesta-hw-sleep;

		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel0_in: endpoint {
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;
				panel1_in: endpoint {
					remote-endpoint = <&mdss_dsi1_out>;
				};
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel0_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	vdds-supply = <&vreg_l3i_0p88>;
	status = "okay";
};

&mdss_dsi1 {
	vdda-supply = <&vreg_l3g_1p2>;
	qcom,dual-dsi-mode;
	qcom,sync-dual-dsi;
	status = "okay";
};

&mdss_dsi1_out {
	remote-endpoint = <&panel1_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi1_phy {
	vdds-supply = <&vreg_l3i_0p88>;
	status = "okay";
};

/*
 * Real fuel gauge: TI BQ27Z561 on the AP-side I2C HUB SE1 (i2c_hub_1 /
 * i2c@984000, gpio66 SDA / gpio67 SCL), addr 0x55. Ground truth: OnePlus
 * erhai oplus-chg-pack-gauge.dtsi wires oplus_ext_gauge ("bq27z561-battery")
 * on qupv3_hub_i2c1 == mainline i2c_hub_1 (pinctrl hub_i2c1_data_clk,
 * function i2chub0_se1). The old node sat on i2c_hub_3 (wrong controller) with
 * compatible ti,bq27541 (wrong reg map) -> every read NAK'd -6. SoC/V/I/T are
 * readable over standard gauge commands without the SHA-256 HMAC auth (auth
 * only gates OnePlus genuine-battery charging policy, not the gauge readout).
 * Verified v413: bq27z561-0 reports real 61%/4.0V/30C, matches Android.
 */
&i2c_hub_1 {
    status = "okay";
    fuel_gauge: fuel-gauge@55 {
        compatible = "ti,bq27z561";
        reg = <0x55>;
        monitored-battery = <&bat>;
    };
};

/* ===== Audio Phase 1 (v273) — SoundWire codecs + LPASS macros ===== */

&lpass_vamacro {
	pinctrl-names = "default";
	/* VA DMIC pins gpio6-9: without this mux the internal mics capture floating input */
	pinctrl-0 = <&dmic01_default>, <&dmic23_default>;
	vdd-micb-supply = <&vreg_l1b_1p8>;
	qcom,dmic-sample-rate = <4800000>;
};

/* WCD9395 RX (playback) — SoundWire on the RX macro, device 4 (live GT). */
&swr1 {
	status = "okay";

	wcd_rx: codec@0,4 {
		compatible = "sdw20217010e00";
		reg = <0 4>;
		qcom,rx-port-mapping = <1 2 3 4 5 9>;
	};
};

/* WCD9395 TX (capture) — SoundWire, device 3 (live GT). */
&swr2 {
	status = "okay";

	wcd_tx: codec@0,3 {
		compatible = "sdw20217010e00";
		reg = <0 3>;
		qcom,tx-port-mapping = <2 2 3 4>;
	};
};

&tlmm {
	wcd_default: wcd-reset-n-active-state {
		pins = "gpio101";
		function = "gpio";
		drive-strength = <16>;
		bias-disable;
		output-low;
	};
};

/*
 * SECONDARY-TDM pinmux for the AW88261 speaker amps — on the MAIN SoC TLMM.
 * SOLVED 2026-06-21. Android ground truth (OxygenOS live /proc/device-tree):
 * "oplus,speaker-i2s-id" = 1 (SECONDARY), muxed to MAIN-TLMM i2s1:
 *   gpio121=i2s1_sck, gpio122=i2s1_data0, gpio123=i2s1_ws, gpio124=i2s1_data1
 *   (drive 6mA, bias-disable; data1 bias-pull-down). i2s0 (gpio126-129) is the
 *   PRIMARY interface, not the speakers.
 * The PRIOR sec_i2s_active muxed LPI &lpass_tlmm gpio6-9 — which are physically
 * the DMIC pins, the WRONG silicon balls. With that, the ADSP toggled its
 * internal LPAIF SEC-TDM clock but BCLK never reached the amp pins -> SYSST
 * NOCLKS / "check pll lock fail" on EVERY test, regardless of any clock param.
 * THIS was the real cause behind the long-standing "ADSP/ACDB-walled" verdict
 * (all native-TDM / HW_INTF_CLK_CFG tests ran with no physical BCLK at the amps).
 * Applied as the sound{} "default" pinctrl so the machine platform device
 * claims/muxes them at probe (q6apm path has no other TLMM consumer).
 */
&tlmm {
	sec_tdm_active: sec-tdm-active-state {
		sck-pins {
			pins = "gpio121";
			function = "i2s1_sck";
			drive-strength = <6>;
			bias-disable;
		};

		ws-pins {
			pins = "gpio123";
			function = "i2s1_ws";
			drive-strength = <6>;
			bias-disable;
		};

		data0-pins {
			pins = "gpio122";
			function = "i2s1_data0";
			drive-strength = <6>;
			bias-disable;
		};

		data1-pins {
			pins = "gpio124";
			function = "i2s1_data1";
			drive-strength = <6>;
			bias-pull-down;
		};
	};
};

/* Adreno 830 v2 (gen8-0-1) */
&gpu {
	status = "okay";
};

/*
 * The generic sm8750 GMU frequencies (550MHz@SVS / 220MHz@LOW_SVS) do not
 * apply to this variant: 220MHz is below the floor its GMU supports, which
 * makes the CX level vote marginal and the bring-up reset non-deterministic.
 * This part runs 500MHz@LOW_SVS / 650MHz@SVS.
 */
&gmu_opp_table {
	/delete-node/ opp-550000000;
	/delete-node/ opp-220000000;

	opp-650000000 {
		opp-hz = /bits/ 64 <650000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
	};

	opp-500000000 {
		opp-hz = /bits/ 64 <500000000>;
		opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
	};
};

/*
 * v449: enable the iris3 HW video codec (decode/encode). Node fully defined in
 * sm8750.dtsi but kept status=disabled upstream because the iris fw is vendor-
 * signed. We stage the device's own signed blob (/vendor/firmware/vpu35_4v.mbn)
 * onto sda17 as qcom/vpu/vpu35_p4.mbn (the name the iris driver requests), so
 * qcom_scm_pas_auth_and_reset authenticates against the OEM-fused TZ keys.
 * Requires CONFIG_VIDEO_QCOM_IRIS=m (.config) + REBUILD_MODULES=1.
 */
&iris {
	status = "okay";
};

/*
 * v469: LITERAL cnss2 platform-driver port — WCN7880 internal WiFi test node.
 *
 * Goal: bind the OnePlus/Qualcomm downstream cnss2 platform driver (ported
 * verbatim to drivers/net/wireless/cnss2) to the peach endpoint INSTEAD of
 * ath12k, to test whether Android's native host bring-up (QMI + MHI + cal
 * sequence) completes WCN7880 cold-boot calibration or asserts identically at
 * wal_pm_wmac_assert_phy_off line#178.
 *
 * Power model: the wcn7880-pmu (qcom,wcn7850-pmu) pwrseq keeps owning power +
 * wlan-en (tlmm16) + the WCN7880 RF-voltage fix, and pcie0/pcieport0 keep
 * enumerating the 0x17cb:0x110e endpoint at boot. So the power path is
 * IDENTICAL to the ath12k baseline — the ONLY variable under test is the host
 * driver's QMI/MHI/cal sequence. cnss2 therefore does NOT own regulators or
 * wlan-en here (those props are omitted); it takes over only the SOL + PCI
 * WAKE gpios (inert on wifi@0 once ath12k is blacklisted) and the QMP/AOP link.
 *
 * ath12k is kept off the endpoint via cmdline modprobe.blacklist=ath12k; the
 * cnss2 modules are modprobed after boot (cnss2 pulls wlan_firmware_service,
 * cnss_plat_ipc_qmi_svc, mhi, cnss_prealloc, cnss_utils).
 *
 * NOT yet wired (add iteratively if the first boot reaches cal and re-asserts):
 * the downstream qcom,pdc_init_table / vreg_pdc_map / interconnects.
 */
&soc {
	wlan_peach: qcom,cnss-peach@b0000000 {
		compatible = "qcom,cnss-peach";
		reg = <0x0 0xb0000000 0x0 0x10000>;
		reg-names = "smmu_iova_ipa";

		qcom,wlan;
		supported-ids = <0x110E>;
		qcom,wlan-rc-num = <0>;

		/* Enable standalone cold-boot calibration (CBC): cnss2 posts
		 * COLD_BOOT_CAL_START when userspace writes 1 to the sysfs
		 * fs_ready attr. This is the cal path we test WITHOUT qcacld. */
		qcom,wlan-cbc-enabled;

		/* SOL + PCI WAKE gpios (same pins ath12k used on wifi@0; ath12k
		 * is blacklisted so only cnss2 requests them). Load-bearing for
		 * the cold-boot-cal preamble. */
		wlan-host-sol-gpio = <&tlmm 202 0>;
		wlan-dev-sol-gpio = <&tlmm 203 0>;
		wlan-pci-wake-gpio = <&tlmm 104 0>;

		/* AOP/PDC comms (direct QMP, not mailbox) — matches downstream */
		qcom,qmp = <&aoss_qmp>;

		qcom,wlan-ramdump-dynamic = <0x780000>;
		cnss-enable-self-recovery;
	};
};

/* ============================================================================
 * SuperVOOC fast charging — dual Southchip SC8547A charge pump (master + slave)
 *
 * Ground truth (live OxygenOS /proc/device-tree, 2026-07-10):
 *   master  oplus,sc8547a@6F         on i2c@9a0000 == mainline i2c_hub_8,
 *           addr 0x6F, IRQ on tlmm gpio163 (falling), ovp_reg 0x36 ocp_reg 0x0b.
 *   slave   sc8547-charger-slave@6F  on i2c@988000 == mainline i2c_hub_2,
 *           addr 0x6F, no IRQ.
 * Both are SC8547A 2:1 charge pumps with an integrated VOOC serial PHY
 * (DEVICE_ID 0x67 @ REG_36). Driven AP-side by voocphy — no ADSP needed for the
 * fast-charge path. Standalone driver drivers/power/supply/sc8547a.c
 * (CONFIG_CHARGER_SC8547A). ovp/ocp reg values pinned to the Android ones.
 * ============================================================================
 */
&i2c_hub_8 {
	status = "okay";

	sc8547a_master: charge-pump@6f {
		compatible = "oplus,sc8547a";
		reg = <0x6f>;

		interrupts-extended = <&tlmm 163 IRQ_TYPE_EDGE_FALLING>;
		pinctrl-names = "default";
		pinctrl-0 = <&sc8547_int_active>;

		sc,vbat-ovp-reg = /bits/ 8 <0x36>;
		sc,ibus-ocp-reg = /bits/ 8 <0x0b>;
	};
};

&i2c_hub_2 {
	status = "okay";

	sc8547a_slave: charge-pump@6f {
		compatible = "oplus,sc8547a";
		reg = <0x6f>;
		oplus,slave;

		sc,vbat-ovp-reg = /bits/ 8 <0x36>;
		sc,ibus-ocp-reg = /bits/ 8 <0x0b>;
	};
};

&tlmm {
	sc8547_int_active: sc8547-int-active-state {
		pins = "gpio163";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};
};

/* ---------------------------------------------------------------------------
 * Rear main camera — SmartSens SC1320CS 13MP (Phase-A bring-up)
 * CCI0 master1 (gpio115 SDA / gpio116 SCL), slave 0x36, chip id 0xc658,
 * MCLK cambistmclkcc MCLK1 (gpio90, 19.2MHz), reset pm8550ve_i gpio5.
 * Rails: vana L16B 2.8V, vio L4B 1.8V, vdig L1I 1.2V, vaf L9B 2.8V.
 * Ground truth: captures/camera-bringup-2026-07-11/CAMERA-GROUNDTRUTH.md
 * ------------------------------------------------------------------------- */

/* sid-8 PMIC that carries the rear camera reset gpio (absent in mainline) */
&spmi_bus {
	pm8550ve_i: pmic@8 {
		compatible = "qcom,pm8550ve", "qcom,spmi-pmic";
		reg = <0x8 SPMI_USID>;
		#address-cells = <1>;
		#size-cells = <0>;

		pm8550ve_i_gpios: gpio@8800 {
			compatible = "qcom,pm8550ve-gpio", "qcom,spmi-gpio";
			reg = <0x8800>;
			gpio-controller;
			gpio-ranges = <&pm8550ve_i_gpios 0 0 8>;
			#gpio-cells = <2>;
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};
};

&tlmm {
	cam_rear_mclk_default: cam-rear-mclk-default-state {
		pins = "gpio90";
		function = "cam_mclk";
		drive-strength = <2>;
		bias-disable;
	};

	/* Front SC820CS MCLK4 output pin (Android cam_sensor_mclk4_active).
	 * gpio93's mainline TLMM function is cam_aon_mclk4 (always-on MCLK4),
	 * NOT the generic cam_mclk used on gpio90 — mismuxing it leaves the pad
	 * unclocked and the sensor never boots (I2C no-ACK at any address). */
	cam_front_mclk_default: cam-front-mclk-default-state {
		pins = "gpio93";
		function = "cam_aon_mclk4";
		drive-strength = <2>;
		bias-disable;
	};

	cci0_i2c_sda1_default: cci0-i2c-sda1-default-state {
		pins = "gpio115";
		function = "cci_i2c_sda";
		drive-strength = <2>;
		/* Android cci_i2c_sda1_active: qcom,i2c_pull + bias-pull-up.
		 * bias-disable here left SDA floating; when cci_init() arms the
		 * full IRQ error/halt mask, CCI flags a bus-busy/error on the
		 * floating line -> error IRQ -> HALT_REQ -> HALT_ACK -> RESET ->
		 * RST_DONE storm = uninterruptible IRQ livelock (box hangs, no
		 * reboot). Pull-up idles the bus high like Android. */
		bias-pull-up;
	};

	cci0_i2c_scl1_default: cci0-i2c-scl1-default-state {
		pins = "gpio116";
		function = "cci_i2c_scl";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&soc {
	cci0: cci@ac7b000 {
		compatible = "qcom,sm8750-cci", "qcom,msm8996-cci";
		/*
		 * v491: FULLY runtime-deferred CCI bring-up (camss stays disabled).
		 *
		 * v490 black-screened even with the CSR readl gated in-probe, proving
		 * the hang is BEFORE the register access — it is the clk-core defaults
		 * (of_clk_set_defaults applies assigned rates), the genpd power-on of
		 * TITAN_TOP_GDSC, or cci_enable_clocks, all of which the driver core
		 * runs at/before probe regardless of any in-probe gate. A boot hang is
		 * uncapturable here (no serial, Mu wipes DRAM).
		 *
		 * So CONFIG_I2C_QCOM_CCI is now =m and boot-blacklisted
		 * (modprobe.blacklist=i2c_qcom_cci). The cci0 device exists but no
		 * driver binds at boot => nothing is touched => the tablet boots
		 * exactly like the camera-off baseline. The entire clock/power/CSR
		 * path is then exercised from a running system:
		 *   modprobe i2c-qcom-cci      # clocks + GDSC + rate dump (erhai_cci_csr=0)
		 *   echo 1 > /sys/module/i2c_qcom_cci/parameters/erhai_cci_csr
		 *   echo ac7b000.cci > /sys/bus/platform/drivers/i2c-qcom-cci/unbind
		 *   echo ac7b000.cci > /sys/bus/platform/drivers/i2c-qcom-cci/bind
		 * A hang costs only a reboot (boot slot intact); an abort gives a
		 * clean oops with the faulting PC.
		 */
		status = "okay";
		/* reg[0] = CCI CSR; reg[1] = CPAS-TOP (for the qchannel wakeup).
		 * NB the node is named @ac13000 but cam_cpas_top MMIO is at ac04000. */
		reg = <0 0x0ac7b000 0 0x1000>,
		      <0 0x0ac04000 0 0x1000>;
		reg-names = "cci", "cpas_top";
		interrupts = <GIC_SPI 426 IRQ_TYPE_EDGE_RISING>;
		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		/*
		 * v492: THE FIX. v491 proved clocks+GDSC alone leave 0xac7b000
		 * unreachable (readl stalls the NoC at runtime). The camera config
		 * register aperture sits behind the config-NoC, which is closed until
		 * the CPU->camera-cfg AHB path is voted. This is exactly the "ahb"
		 * interconnect mainline camss votes (MASTER_APPSS_PROC ->
		 * SLAVE_CAMERA_CFG). The i2c-qcom-cci driver in this build does
		 * icc_set_bw() on it before the CSR readl.
		 */
		/*
		 * v495: + CAMNOC data-path mnoc votes. cam_hf/cam_sf are the members
		 * of mainline bcm_mm1 (the RPMh CAMNOC BCM); voting them fires that
		 * BCM to bring the CAMNOC fabric out of retention (downstream CPAS
		 * apply_default_axi_vote, before qchannel). Tests whether the dropped
		 * CPAS-TOP control writes / never-asserting QACCEPTN are just a
		 * missing RPMh camnoc wake — no CESTA/CRM (mainline manual-controls
		 * the camnoc RCG; dispcc "cesta" TODO — display works this way).
		 */
		interconnects = <&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
				 &config_noc SLAVE_CAMERA_CFG QCOM_ICC_TAG_ACTIVE_ONLY>,
				<&mmss_noc MASTER_CAMNOC_HF QCOM_ICC_TAG_ALWAYS
				 &mmss_noc SLAVE_MNOC_HF_MEM_NOC QCOM_ICC_TAG_ALWAYS>,
				<&mmss_noc MASTER_CAMNOC_SF QCOM_ICC_TAG_ALWAYS
				 &mmss_noc SLAVE_MNOC_SF_MEM_NOC QCOM_ICC_TAG_ALWAYS>;
		interconnect-names = "ahb", "cam_hf", "cam_sf";
		/*
		 * v491: MINIMAL clock set = the mainline sm8650/sm8550 CCI recipe
		 * ({camnoc_axi_nrt, cpas_ahb, cci} + TITAN_TOP_GDSC), mapped to
		 * sm8750 camcc IDs. sm8650 reaches the CSR with exactly these and no
		 * assigned rates, so start from that proven-on-sibling set instead of
		 * v484's 16-clock over-provision (whose pinned rates on shared RCGs
		 * are a prime suspect for the black-screen — forcing camnoc_rt_src to
		 * 400MHz drags PLL0 via CLK_SET_RATE_PARENT). sm8750 has no
		 * CAM_CC_CPAS_AHB_CLK, so cover both AHB branches the Android CPAS
		 * lists as cpas_ahb / cpas_core_ahb (cam_top_ahb + core_ahb). Only
		 * cci_0_clk_src is pinned (37.5MHz, I2C bit timing; harmless).
		 * This whole path now runs at runtime via modprobe, not at boot.
		 */
		/*
		 * v494: qchannel needs more than clocks-at-XO. Add the ICP-0 CORE
		 * clock (v880 errata enable_icp_clk_for_qchannel — "cam_icp_clk" =
		 * CAM_CC_ICP_0_CLK, not the AHB) and run the CAMNOC at real AXI speed
		 * (400MHz off the already-running PLL0_OUT_EVEN, vs the 19.2MHz XO
		 * default) so the CAMNOC HF/SF Q-Channel state machine can assert
		 * QACCEPTN. Both are runtime rate-sets (module path), no boot risk.
		 */
		/*
		 * GCC camera clocks (gcc_camera_ahb/hf/sf_axi) live in a DIFFERENT
		 * clock controller than the cam_cc leaves above, so enabling any
		 * cam_cc clock does NOT pull them up. They gate the CAMNOC<->mem_noc
		 * AXI master ports; without them the CAMNOC quiescence handshake
		 * (qchannel QACCEPTN) can't complete and the CCI reset FSM — which
		 * waits on that NoC handshake — never finishes (RST_DONE never fires,
		 * reads post-RESET_CMD wedge, NoC-timeout resets the SoC ~2s later).
		 * Downstream cam-cpas enables gcc_axi_hf/sf as part of its 15-clock
		 * bring-up before qchannel. Replay that here.
		 */
		clocks = <&camcc CAM_CC_CAMNOC_NRT_AXI_CLK>,
			 <&camcc CAM_CC_CAM_TOP_AHB_CLK>,
			 <&camcc CAM_CC_CORE_AHB_CLK>,
			 <&camcc CAM_CC_CCI_0_CLK>,
			 <&camcc CAM_CC_ICP_0_AHB_CLK>,
			 <&camcc CAM_CC_ICP_0_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_AXI_CLK>,
			 <&gcc GCC_CAMERA_AHB_CLK>,
			 <&gcc GCC_CAMERA_HF_AXI_CLK>,
			 <&gcc GCC_CAMERA_SF_AXI_CLK>;
		clock-names = "camnoc_axi", "cpas_ahb", "cpas_core_ahb", "cci",
			      "icp_ahb", "icp", "camnoc_rt",
			      "gcc_cam_ahb", "gcc_cam_hf_axi", "gcc_cam_sf_axi";
		assigned-clocks = <&camcc CAM_CC_CCI_0_CLK_SRC>,
				  <&camcc CAM_CC_ICP_0_CLK_SRC>,
				  <&camcc CAM_CC_CAMNOC_RT_AXI_CLK_SRC>;
		assigned-clock-rates = <37500000>,
				       <300000000>,
				       <400000000>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&cci0_i2c_sda1_default &cci0_i2c_scl1_default>;
		pinctrl-1 = <&cci0_i2c_sda1_default &cci0_i2c_scl1_default>;
		#address-cells = <1>;
		#size-cells = <0>;

		/*
		 * master[0] MUST exist even though our sensor is on master 1:
		 * cci_reset() hardcodes cci->master[0].irq_complete for the
		 * reset-done wait ("for implicity"), and that completion is only
		 * init_completion()'d for masters that have an i2c-bus child. With
		 * only i2c-bus@1 present, wait_for_completion() on master[0]'s
		 * uninitialized swait list OOPSes in probe context (segfaults the
		 * bind writer, holds the CCI lock -> box hangs, no reboot). Empty
		 * bus@0 initializes master[0]; we never xfer on it.
		 */
		cci0_i2c0: i2c-bus@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;
		};

		cci0_i2c1: i2c-bus@1 {
			reg = <1>;
			/*
			 * FAST (400kHz) is the fastest this bus sustains; at
			 * FAST_PLUS (1MHz) SCL never rises to VIH inside thigh,
			 * so the master stalls mid-write forever (-ETIMEDOUT,
			 * no NACK, no error IRQ). Matches the downstream
			 * default for a cam_sensor with no i2c-freq-mode.
			 */
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			sc1320cs: camera-sensor@36 {
				compatible = "smartsens,sc1320cs";
				reg = <0x36>;

				clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
				clock-names = "cam_clk";
				assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK1_CLK>;
				assigned-clock-rates = <19200000>;

				pinctrl-names = "default";
				pinctrl-0 = <&cam_rear_mclk_default>;

				reset-gpios = <&pm8550ve_i_gpios 5 GPIO_ACTIVE_LOW>;

				/* Rear-facing module. Lets the driver export
				 * V4L2_CID_CAMERA_ORIENTATION=BACK so libcamera
				 * reports location=back and GNOME Snapshot stops
				 * mirroring the captured picture. */
				orientation = <1>;
				rotation = <0>;

				cam_vana-supply = <&vreg_l16b_2p8>;
				cam_vio-supply  = <&vreg_l4b_1p8>;
				cam_vdig-supply = <&vreg_l1i_1p2>;
				cam_vaf-supply  = <&vreg_l9b_2p9>;

				/* Rear AF voice-coil motor (CN3927-
				 * compatible, CCI0-m1 slave 0x0c). Lets
				 * libcamera attach a lens object to this
				 * sensor; the VCM subdev keeps its own
				 * VAF regulator reference. */
				lens-focus = <&vcm>;

				/* MIPI CSI-2 D-PHY 4-lane out -> CAMSS CSIPHY4 */
				port {
					sc1320cs_ep: endpoint {
						remote-endpoint = <&camss_csiphy4>;
						data-lanes = <0 1 2 3>;
						/*
						 * Android CAM_START_PHYDEV for PHY-4:
						 * Datarate 1200000000 per lane, so the
						 * DDR link clock is half that. camss
						 * takes the rate it actually programs
						 * from the sensor's V4L2_CID_LINK_FREQ,
						 * not from here; keep the two in step.
						 */
						link-frequencies = /bits/ 64 <600000000>;
					};
				};
			};

			/*
			 * Rear-camera AF voice-coil motor, CCI master 1,
			 * slave 0x0c.  CN3927-compatible protocol: unlock
			 * 0xed, params 0x06/0x07/0x08, 10-bit DAC position
			 * at regs 0x03 (MSB[1:0]) / 0x04 (LSB) — verified
			 * with i2ctransfer (erhai-cam-focus.sh).  The VAF
			 * rail is shared with the sensor; the regulator
			 * core refcounts it, so the VCM subdev can also
			 * power it while no preview is streaming.
			 */
			vcm: lens@c {
				compatible = "chipnext,cn3927";
				reg = <0x0c>;

				vio-supply = <&vreg_l4b_1p8>;
				vaf-supply = <&vreg_l9b_2p9>;
			};
		};
	};
};

/*
 * Front camera — SmartSens SC820CS 8MP (Phase-A bring-up).
 * GENI I2C (qupv3_se9 = i2c@884000), slave 7-bit 0x10 (Android write 0x20),
 * chip id 0xd154, CSIPHY5. MCLK cambistmclkcc MCLK4 (gpio93, 19.2MHz), reset
 * tlmm gpio7. Rails: vana L16B 2.8V, vio L4B 1.8V, vdig L11B 1.2V (no AF).
 * Ground truth: captures/camera-bringup-2026-07-11/erhai_camera_overlay_common_evb.dtsi
 * (qcom,cam-sensor1) + CAMERA-GROUNDTRUTH.md.
 *
 * Phase-A = probe + chip-id over GENI only; the 3264x2448 streaming register
 * table is not yet captured (front rides GENI, not the CCI the rear trace saw),
 * so the sensor detects but does not stream (see sc820cs.c Phase-B note).
 */
&i2c9 {
	status = "okay";
	clock-frequency = <400000>;

	sc820cs: camera-sensor@10 {
		compatible = "smartsens,sc820cs";
		reg = <0x10>;

		clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		clock-names = "cam_clk";
		assigned-clocks = <&cambistmclkcc CAM_BIST_MCLK_CC_MCLK4_CLK>;
		assigned-clock-rates = <19200000>;

		pinctrl-names = "default";
		pinctrl-0 = <&cam_front_mclk_default>;

		reset-gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;

		/* orientation=BACK (1) so GNOME Snapshot applies NO mirror to
		 * either preview or capture (measured: FRONT mirrors the preview
		 * only, BACK mirrors neither); paired with sensor 0x3221=0x60
		 * (H-mirror off) the front image lands un-mirrored on screen and
		 * on disk. (Cost: libcamera reports this front sensor as location
		 * back — cosmetic; the requirement is an un-mirrored image.) */
		orientation = <1>;
		rotation = <0>;

		cam_vana-supply = <&vreg_l16b_2p8>;
		cam_vio-supply  = <&vreg_l4b_1p8>;
		cam_vdig-supply = <&vreg_l11b_1p0>;

		/* MIPI CSI-2 D-PHY 4-lane out -> CAMSS CSIPHY5.
		 * Android CAM_START_PHYDEV PHY-5: Datarate 736000000/lane, so
		 * the DDR link clock is half; camss takes the rate from the
		 * sensor's V4L2_CID_LINK_FREQ, keep the two in step. */
		port {
			sc820cs_ep: endpoint {
				remote-endpoint = <&camss_csiphy5>;
				data-lanes = <0 1 2 3>;
				link-frequencies = /bits/ 64 <368000000>;
			};
		};
	};
};

/*
 * CAMSS receive pipeline — RDI-LITE-ONLY variant (Phase-B).
 * Exposes CSIPHY0-5 + 2 CSID-lite + 2 VFE-lite (the only sun blocks that map to
 * mainline gen3 ops). Rear sensor SC1320CS streams sensor->CSIPHY4->CSID-lite->
 * VFE-lite RDI raw dump. Full pixel/TFE ISP path (mc_tfe980/csid980, no CPAS
 * clocks in camcc) is out of scope — future TFE driver. See PHASE-B-PLAN.md +
 * camss.c sm8750_resources comment.
 *
 * ⚠ First-cut values pending on-device probe (full-replay-then-prune):
 *   - CSID/VFE-lite reg bases assume sm8650's csid+0x1000=vfe split applied to
 *     sun lite window (csid_lite0 ad6d000, vfe_lite0 ad6e000). 980 vs gen3
 *     register-layout deltas surface at HW_VERSION read.
 *   - CSIPHY analog rails (csi-vdd-1p2/0p9) omitted; add if PHY won't lock.
 *   - iommus (SMMU SIDs) + interconnects deferred until frame-capture milestone.
 */
&soc {
	camss: isp@ad6d000 {
		compatible = "qcom,sm8750-camss";

		reg = <0 0x0ada9000 0 0x2000>,
		      <0 0x0adab000 0 0x2000>,
		      <0 0x0adad000 0 0x2000>,
		      <0 0x0adaf000 0 0x2000>,
		      <0 0x0adb1000 0 0x2000>,
		      <0 0x0adb3000 0 0x2000>,
		      <0 0x0ad6d000 0 0x1000>,
		      <0 0x0ad72000 0 0x1000>,
		      <0 0x0ad6e000 0 0x2000>,
		      <0 0x0ad73000 0 0x2000>;
		reg-names = "csiphy0",
			    "csiphy1",
			    "csiphy2",
			    "csiphy3",
			    "csiphy4",
			    "csiphy5",
			    "csid_lite0",
			    "csid_lite1",
			    "vfe_lite0",
			    "vfe_lite1";

		clocks = <&camcc CAM_CC_CSIPHY0_CLK>,
			 <&camcc CAM_CC_CSI0PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY1_CLK>,
			 <&camcc CAM_CC_CSI1PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY2_CLK>,
			 <&camcc CAM_CC_CSI2PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY3_CLK>,
			 <&camcc CAM_CC_CSI3PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY4_CLK>,
			 <&camcc CAM_CC_CSI4PHYTIMER_CLK>,
			 <&camcc CAM_CC_CSIPHY5_CLK>,
			 <&camcc CAM_CC_CSI5PHYTIMER_CLK>,
			 <&camcc CAM_CC_IFE_LITE_AHB_CLK>,
			 <&camcc CAM_CC_IFE_LITE_CSID_CLK>,
			 <&camcc CAM_CC_IFE_LITE_CPHY_RX_CLK>,
			 <&gcc GCC_CAMERA_HF_AXI_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_AXI_CLK>,
			 <&camcc CAM_CC_IFE_LITE_CLK>,
			 <&camcc CAM_CC_QDSS_DEBUG_XO_CLK>,
			 <&camcc CAM_CC_CAMNOC_RT_IFE_LITE_CLK>;
		clock-names = "csiphy0",
			      "csiphy0_timer",
			      "csiphy1",
			      "csiphy1_timer",
			      "csiphy2",
			      "csiphy2_timer",
			      "csiphy3",
			      "csiphy3_timer",
			      "csiphy4",
			      "csiphy4_timer",
			      "csiphy5",
			      "csiphy5_timer",
			      "vfe_lite_ahb",
			      "vfe_lite_csid",
			      "vfe_lite_cphy_rx",
			      "gcc_axi_hf",
			      "camnoc_axi",
			      "vfe_lite",
			      "qdss_debug_xo",
			      "camnoc_rt_ife_lite";

		interrupts = <GIC_SPI 477 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 478 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 479 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 448 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 122 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 89 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 605 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 376 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 606 IRQ_TYPE_EDGE_RISING>,
			     <GIC_SPI 377 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csiphy0",
				  "csiphy1",
				  "csiphy2",
				  "csiphy3",
				  "csiphy4",
				  "csiphy5",
				  "csid_lite0",
				  "csid_lite1",
				  "vfe_lite0",
				  "vfe_lite1";

		/*
		 * v498: without this, every VIDIOC_REQBUFS fails -ENOMEM with
		 * "swiotlb buffer is full (sz: 4194304 bytes)" — with no iommus
		 * the ISP gets no IOMMU domain, falls back to swiotlb bouncing,
		 * and a 16MB RAW frame will never fit there.
		 *
		 * SID from the live Android DT, not derived: downstream keeps the
		 * mapping on the SMMU context-bank nodes rather than on the IFE
		 * devices, and qcom,cam_smmu/msm_cam_smmu_ife (cam-smmu-label
		 * "ife" — the CB that ife-lite0/1 belong to) carries
		 * iommus = <&apps_smmu 0x1c00 0x0> plus dma-coherent. The camera
		 * SID block is 0x1800..0x1c00 (rt-cdm 0x1860, jpeg 0x18a0,
		 * icp 0x1820/0x1800 mask 0xc0/0x1980).
		 *
		 * mask stays 0x0 as Android has it. If a VFE-lite write ever uses
		 * a SID outside 0x1c00, apps_smmu reports the exact SID in its
		 * "Unhandled context fault" line — read it, don't widen the mask
		 * on a guess.
		 */
		iommus = <&apps_smmu 0x1c00 0x0>;
		dma-coherent;

		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
		power-domain-names = "top";

		/*
		 * v497: ENABLED. The v482 hold was that several bases were guesses
		 * and a wrong one is an unclocked-MMIO NoC hang; all 10 windows and
		 * all 10 IRQs are now verified against the live Android DT:
		 *   csiphy0-5   ada9000/adab000/adad000/adaf000/adb1000/adb3000 (0x2000)
		 *   csid_lite0/1 ad6d000 / ad72000
		 *   vfe_lite0/1  ad6e000 / ad73000  (= csid_lite + 0x1000, the sm8650
		 *     mainline convention; downstream's single "ife-lite" window is a
		 *     0x2800 superset starting at the csid_lite base, i.e. consistent)
		 *   IRQs 477/478/479/448/122/89, 605/376, 606/377
		 * Its precondition also holds now: CCI + SC1320CS chip-id read OK.
		 */
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@4 {
				reg = <4>;

				camss_csiphy4: endpoint {
					remote-endpoint = <&sc1320cs_ep>;
					data-lanes = <0 1 2 3>;
				};
			};

			port@5 {
				reg = <5>;

				camss_csiphy5: endpoint {
					remote-endpoint = <&sc820cs_ep>;
					data-lanes = <0 1 2 3>;
				};
			};
		};
	};
};
